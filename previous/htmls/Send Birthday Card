          <div class="relative">
            <textarea
              class="w-full rounded-xl border-primary/20 bg-white dark:bg-background-dark/50 text-slate-900 dark:text-slate-100 focus:border-primary focus:ring-primary p-4 text-base placeholder:text-slate-400"
