              placeholder="Write a heartfelt birthday message..."
              rows="5"
            ></textarea>
            <div class="absolute bottom-3 right-3 text-slate-400 text-xs">
              0/250
            </div>
          </div>
        </div>
        <!-- Recipient Preview -->
        <div class="px-4 pb-8">
          <div
            class="flex items-center gap-3 p-4 rounded-xl bg-primary/5 border border-primary/10"
