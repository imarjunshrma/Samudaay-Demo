      <div
        class="flex gap-2 border-t border-primary/10 bg-background-light dark:bg-background-dark px-4 pb-6 pt-2"
      >
        <a
          class="flex flex-1 flex-col items-center justify-end gap-1 text-slate-500 dark:text-slate-400"
          href="#"
        >
          <div class="flex h-8 items-center justify-center">
            <span class="material-symbols-outlined">home</span>
          </div>
          <p
            class="text-[10px] font-medium leading-normal tracking-wide uppercase"
