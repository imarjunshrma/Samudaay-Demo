                Leather Craft
              </p>
            </div>
          </div>
          <!-- Template Item 3 -->
          <div class="group relative cursor-pointer">
            <div
              class="bg-cover bg-center flex flex-col gap-3 rounded-xl justify-end p-4 aspect-[3/4] border-2 border-transparent hover:border-primary/50 transition-all overflow-hidden"
              data-alt="Elegant soft pink and white floral arrangement"
              style="
                background-image:
                  linear-gradient(
                    0deg,
