<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Create Notification - Cobbler Community</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#f2780d",
              "background-light": "#f8f7f5",
              "background-dark": "#221810",
            },
            fontFamily: {
              display: ["Public Sans"],
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              full: "9999px",
            },
          },
        },
      };
    </script>
    <style>
      body {
        min-height: max(884px, 100dvh);
      }
    </style>
  </head>
  <body
    class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 min-h-screen"
  >
    <div
      class="relative flex h-auto min-h-screen w-full flex-col max-w-2xl mx-auto border-x border-primary/10 bg-background-light dark:bg-background-dark overflow-x-hidden"
    >
      <!-- TopAppBar -->
      <div
        class="flex items-center bg-background-light dark:bg-background-dark p-4 pb-2 justify-between sticky top-0 z-10 border-b border-primary/10"
      >
        <div
          class="text-primary flex size-12 shrink-0 items-center cursor-pointer"
        >
          <span class="material-symbols-outlined">arrow_back</span>
        </div>
        <h2
          class="text-slate-900 dark:text-slate-100 text-lg font-bold leading-tight tracking-[-0.015em] flex-1 ml-2"
        >
          Create Notification
        </h2>
        <div class="size-12 flex items-center justify-end">
          <span class="material-symbols-outlined text-slate-500"
            >more_vert</span
          >
        </div>
      </div>
      <div class="flex flex-col gap-6 p-4">
        <!-- Notification Title -->
        <div class="flex flex-wrap items-end gap-4 w-full">
          <label class="flex flex-col min-w-40 flex-1">
            <p
              class="text-slate-800 dark:text-slate-200 text-base font-semibold leading-normal pb-2"
            >
              Notification Title
            </p>
            <input
              class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-slate-900 dark:text-slate-100 focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-primary/20 bg-white dark:bg-slate-800 focus:border-primary h-14 placeholder:text-slate-400 p-[15px] text-base font-normal leading-normal"
              placeholder="e.g. Monthly Community Meetup"
              type="text"
              value=""
            />
          </label>
        </div>
        <!-- Message Area -->
        <div class="flex flex-wrap items-end gap-4 w-full">
          <label class="flex flex-col min-w-40 flex-1">
            <p
              class="text-slate-800 dark:text-slate-200 text-base font-semibold leading-normal pb-2"
            >
              Message
            </p>
            <textarea
              class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-slate-900 dark:text-slate-100 focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-primary/20 bg-white dark:bg-slate-800 focus:border-primary min-h-[160px] placeholder:text-slate-400 p-[15px] text-base font-normal leading-normal"
              placeholder="Write your announcement for the Indian Cobbler Community..."
            ></textarea>
          </label>
        </div>
        <!-- Upload Image Button -->
        <div class="flex justify-start">
          <button
            class="flex min-w-[140px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-6 bg-primary/10 text-primary border border-primary/20 hover:bg-primary/20 transition-colors gap-2 font-bold leading-normal tracking-[0.015em]"
          >
            <span class="material-symbols-outlined">upload</span>
            <span class="truncate">Upload Image</span>
          </button>
        </div>
        <!-- Send To Selection -->
        <div class="pt-4 border-t border-primary/10">
          <h3
            class="text-slate-900 dark:text-slate-100 text-lg font-bold leading-tight tracking-[-0.015em] mb-4"
          >
            Send To
          </h3>
          <div class="grid grid-cols-2 gap-3 mb-6">
            <label
              class="relative flex items-center p-4 rounded-xl border border-primary/20 bg-white dark:bg-slate-800 cursor-pointer hover:border-primary transition-all group"
            >
              <input
                checked=""
                class="w-5 h-5 text-primary border-primary/30 focus:ring-primary"
                name="recipient"
                type="radio"
              />
              <span class="ml-3 font-medium text-slate-700 dark:text-slate-200"
                >All Users</span
              >
            </label>
            <label
              class="relative flex items-center p-4 rounded-xl border border-primary/20 bg-white dark:bg-slate-800 cursor-pointer hover:border-primary transition-all"
            >
              <input
                class="w-5 h-5 text-primary border-primary/30 focus:ring-primary"
                name="recipient"
                type="radio"
              />
              <span class="ml-3 font-medium text-slate-700 dark:text-slate-200"
                >Trustees</span
              >
            </label>
            <label
              class="relative flex items-center p-4 rounded-xl border border-primary/20 bg-white dark:bg-slate-800 cursor-pointer hover:border-primary transition-all"
            >
              <input
                class="w-5 h-5 text-primary border-primary/30 focus:ring-primary"
                name="recipient"
                type="radio"
              />
              <span class="ml-3 font-medium text-slate-700 dark:text-slate-200"
                >Members</span
              >
            </label>
            <label
              class="relative flex items-center p-4 rounded-xl border border-primary/20 bg-white dark:bg-slate-800 cursor-pointer hover:border-primary transition-all"
            >
              <input
                class="w-5 h-5 text-primary border-primary/30 focus:ring-primary"
                name="recipient"
                type="radio"
              />
              <span class="ml-3 font-medium text-slate-700 dark:text-slate-200"
                >Specific Group</span
              >
            </label>
          </div>
          <!-- Specific Group Search (Visible when 'Specific Group' is active) -->
          <div class="relative w-full">
            <p
              class="text-slate-800 dark:text-slate-200 text-sm font-semibold leading-normal pb-2"
            >
              Select Group
            </p>
            <div class="relative">
              <span
                class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"
                >search</span
              >
              <input
                class="form-input flex w-full pl-12 rounded-lg text-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-primary/50 border border-primary/20 bg-white dark:bg-slate-800 h-12 placeholder:text-slate-400 text-sm"
                placeholder="Search for regional groups (e.g. Dharavi Chapter)..."
                type="text"
              />
            </div>
          </div>
        </div>
      </div>
      <!-- Sticky Footer Action -->
      <div
        class="mt-auto p-4 border-t border-primary/10 bg-background-light dark:bg-background-dark sticky bottom-0"
      >
        <button
          class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 px-6 rounded-xl shadow-lg shadow-primary/20 flex items-center justify-center gap-2 transition-transform active:scale-[0.98]"
        >
          <span class="material-symbols-outlined">send</span>
          Send Notification
        </button>
        <p class="text-center text-xs text-slate-500 mt-3 italic">
          This notification will be sent instantly to selected recipients.
        </p>
      </div>
    </div>
  </body>
</html>
