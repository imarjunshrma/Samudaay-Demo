<!DOCTYPE html>

<html class="light" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Indian Cobbler Community Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#f2780d",
              "background-light": "#f8f7f5",
              "background-dark": "#221810",
            },
            fontFamily: {
              display: ["Public Sans"],
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              full: "9999px",
            },
          },
        },
      };
    </script>
    <style>
      body {
        font-family: "Public Sans", sans-serif;
      }
    </style>
    <style>
      body {
        min-height: max(884px, 100dvh);
      }
    </style>
  </head>
  <body
    class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen flex flex-col font-display"
  >
    <!-- Top Navigation / Header -->
    <header
      class="sticky top-0 z-50 bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-md border-b border-primary/10 px-4 py-3 flex items-center justify-between"
    >
      <div class="flex items-center gap-3">
        <div class="bg-primary p-2 rounded-lg text-white">
          <span class="material-symbols-outlined">group</span>
        </div>
        <div>
          <h1 class="text-lg font-bold leading-tight">ICC Analytics</h1>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Indian Cobbler Community
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button
          class="p-2 rounded-full hover:bg-primary/10 text-slate-600 dark:text-slate-300"
        >
          <span class="material-symbols-outlined">search</span>
        </button>
        <button
          class="p-2 rounded-full hover:bg-primary/10 text-slate-600 dark:text-slate-300 relative"
        >
          <span class="material-symbols-outlined">notifications</span>
          <span
            class="absolute top-2 right-2 flex h-2 w-2 rounded-full bg-primary"
          ></span>
        </button>
        <div
          class="h-8 w-8 rounded-full bg-primary/20 flex items-center justify-center border border-primary/30"
        >
          <span class="text-primary font-bold text-xs">AD</span>
        </div>
      </div>
    </header>
    <main class="flex-1 pb-24">
      <!-- Hero Section -->
      <div class="p-4">
        <div
          class="bg-gradient-to-br from-primary to-orange-600 rounded-xl p-6 text-white shadow-lg shadow-primary/20"
        >
          <p class="text-primary-100 text-sm font-medium mb-1">
            Total Community Strength
          </p>
          <h2 class="text-4xl font-extrabold mb-4">12,500+</h2>
          <div
            class="flex items-center gap-2 text-sm bg-white/20 w-fit px-3 py-1 rounded-full"
          >
            <span class="material-symbols-outlined text-sm">trending_up</span>
            <span>12% growth this year</span>
          </div>
        </div>
      </div>
      <!-- Quick Stats Grid -->
      <div class="grid grid-cols-2 gap-4 px-4">
        <div
          class="bg-white dark:bg-slate-800/50 p-4 rounded-xl border border-primary/10"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="material-symbols-outlined text-primary"
              >person_add</span
            >
            <span class="text-xs font-bold text-green-500">+5%</span>
          </div>
          <p class="text-slate-500 dark:text-slate-400 text-xs font-medium">
            New Registrations
          </p>
          <p class="text-xl font-bold mt-1">842</p>
        </div>
        <div
          class="bg-white dark:bg-slate-800/50 p-4 rounded-xl border border-primary/10"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="material-symbols-outlined text-primary"
              >volunteer_activism</span
            >
            <span class="text-xs font-bold text-primary">+8%</span>
          </div>
          <p class="text-slate-500 dark:text-slate-400 text-xs font-medium">
            Active Matrimony
          </p>
          <p class="text-xl font-bold mt-1">2,104</p>
        </div>
      </div>
      <!-- Geographic Breakdown Chart Area -->
      <div class="mt-6 px-4">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold">Members by City</h2>
          <button class="text-primary text-sm font-semibold">View Map</button>
        </div>
        <div
          class="bg-white dark:bg-slate-800/50 rounded-xl p-6 border border-primary/10"
        >
          <div class="flex items-end justify-between h-48 gap-2">
            <!-- Bar Chart Items -->
            <div class="flex flex-col items-center flex-1 gap-2">
              <div
                class="w-full bg-primary/20 rounded-t-lg relative group h-[100%]"
              >
                <div
                  class="absolute inset-0 bg-primary rounded-t-lg h-[90%] bottom-0 mt-auto"
                ></div>
              </div>
              <span class="text-[10px] font-bold text-slate-500 rotate-45 mt-2"
                >Mumbai</span
              >
            </div>
            <div class="flex flex-col items-center flex-1 gap-2">
              <div
                class="w-full bg-primary/20 rounded-t-lg relative group h-[100%]"
              >
                <div
                  class="absolute inset-0 bg-primary rounded-t-lg h-[75%] bottom-0 mt-auto"
                ></div>
              </div>
              <span class="text-[10px] font-bold text-slate-500 rotate-45 mt-2"
                >Delhi</span
              >
            </div>
            <div class="flex flex-col items-center flex-1 gap-2">
              <div
                class="w-full bg-primary/20 rounded-t-lg relative group h-[100%]"
              >
                <div
                  class="absolute inset-0 bg-primary rounded-t-lg h-[60%] bottom-0 mt-auto"
                ></div>
              </div>
              <span class="text-[10px] font-bold text-slate-500 rotate-45 mt-2"
                >Agra</span
              >
            </div>
            <div class="flex flex-col items-center flex-1 gap-2">
              <div
                class="w-full bg-primary/20 rounded-t-lg relative group h-[100%]"
              >
                <div
                  class="absolute inset-0 bg-primary rounded-t-lg h-[45%] bottom-0 mt-auto"
                ></div>
              </div>
              <span class="text-[10px] font-bold text-slate-500 rotate-45 mt-2"
                >Kanpur</span
              >
            </div>
            <div class="flex flex-col items-center flex-1 gap-2">
              <div
                class="w-full bg-primary/20 rounded-t-lg relative group h-[100%]"
              >
                <div
                  class="absolute inset-0 bg-primary rounded-t-lg h-[30%] bottom-0 mt-auto"
                ></div>
              </div>
              <span class="text-[10px] font-bold text-slate-500 rotate-45 mt-2"
                >Chennai</span
              >
            </div>
          </div>
        </div>
      </div>
      <!-- Top Contributors / Recent Activity -->
      <div class="mt-8 px-4">
        <h2 class="text-lg font-bold mb-4">Regional Distribution List</h2>
        <div class="space-y-3">
          <div
            class="flex items-center justify-between p-4 bg-white dark:bg-slate-800/50 rounded-xl border border-primary/5"
          >
            <div class="flex items-center gap-3">
              <div
                class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
              >
                M
              </div>
              <div>
                <p class="font-bold text-sm">Mumbai Metro</p>
                <p class="text-xs text-slate-500">Maharashtra</p>
              </div>
            </div>
            <div class="text-right">
              <p class="font-bold text-sm">3,420</p>
              <p class="text-[10px] text-green-500 font-medium">+2.4%</p>
            </div>
          </div>
          <div
            class="flex items-center justify-between p-4 bg-white dark:bg-slate-800/50 rounded-xl border border-primary/5"
          >
            <div class="flex items-center gap-3">
              <div
                class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
              >
                D
              </div>
              <div>
                <p class="font-bold text-sm">Delhi NCR</p>
                <p class="text-xs text-slate-500">North Region</p>
              </div>
            </div>
            <div class="text-right">
              <p class="font-bold text-sm">2,890</p>
              <p class="text-[10px] text-green-500 font-medium">+1.8%</p>
            </div>
          </div>
          <div
            class="flex items-center justify-between p-4 bg-white dark:bg-slate-800/50 rounded-xl border border-primary/5"
          >
            <div class="flex items-center gap-3">
              <div
                class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
              >
                A
              </div>
              <div>
                <p class="font-bold text-sm">Agra District</p>
                <p class="text-xs text-slate-500">Uttar Pradesh</p>
              </div>
            </div>
            <div class="text-right">
              <p class="font-bold text-sm">1,540</p>
              <p class="text-[10px] text-red-500 font-medium">-0.5%</p>
            </div>
          </div>
        </div>
      </div>
    </main>
    <!-- Bottom Navigation Bar -->
    <nav
      class="fixed bottom-0 left-0 right-0 z-50 bg-white/95 dark:bg-background-dark/95 backdrop-blur-lg border-t border-primary/10 pb-6 pt-2"
    >
      <div class="max-w-md mx-auto flex justify-around items-center px-4">
        <a class="flex flex-col items-center gap-1 group" href="#">
          <div
            class="bg-primary/10 p-2 rounded-xl text-primary group-hover:bg-primary group-hover:text-white transition-all"
          >
            <span class="material-symbols-outlined block">dashboard</span>
          </div>
          <span class="text-[10px] font-bold text-primary">Dashboard</span>
        </a>
        <a class="flex flex-col items-center gap-1 group" href="#">
          <div
            class="p-2 rounded-xl text-slate-400 group-hover:bg-primary/10 group-hover:text-primary transition-all"
          >
            <span class="material-symbols-outlined block">event</span>
          </div>
          <span
            class="text-[10px] font-bold text-slate-400 group-hover:text-primary"
            >Events</span
          >
        </a>
        <a class="flex flex-col items-center gap-1 group" href="#">
          <div
            class="p-2 rounded-xl text-slate-400 group-hover:bg-primary/10 group-hover:text-primary transition-all"
          >
            <span class="material-symbols-outlined block">receipt_long</span>
          </div>
          <span
            class="text-[10px] font-bold text-slate-400 group-hover:text-primary"
            >Transactions</span
          >
        </a>
        <a class="flex flex-col items-center gap-1 group" href="#">
          <div
            class="p-2 rounded-xl text-slate-400 group-hover:bg-primary/10 group-hover:text-primary transition-all"
          >
            <span class="material-symbols-outlined block">favorite</span>
          </div>
          <span
            class="text-[10px] font-bold text-slate-400 group-hover:text-primary"
            >Matrimony</span
          >
        </a>
      </div>
    </nav>
  </body>
</html>
