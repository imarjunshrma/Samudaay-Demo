<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#f2780d",
              "background-light": "#f8f7f5",
              "background-dark": "#221810",
            },
            fontFamily: {
              display: ["Public Sans"],
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              full: "9999px",
            },
          },
        },
      };
    </script>
    <title>Create Matrimony Profile</title>
    <style>
      body {
        min-height: max(884px, 100dvh);
      }
    </style>
  </head>
  <body
    class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 min-h-screen"
  >
    <!-- Top Navigation Bar -->
    <header
      class="sticky top-0 z-50 bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-md border-b border-primary/10"
    >
      <div class="flex items-center p-4 gap-4">
        <button
          class="flex items-center justify-center size-10 rounded-full hover:bg-primary/10 text-slate-900 dark:text-slate-100 transition-colors"
        >
          <span class="material-symbols-outlined">arrow_back</span>
        </button>
        <h1 class="text-lg font-bold leading-tight tracking-tight">
          Create Matrimony Profile
        </h1>
      </div>
    </header>
    <main class="max-w-md mx-auto pb-24">
      <!-- Photo Upload Section -->
      <section class="p-4">
        <h2 class="text-base font-bold mb-3">Upload Photos (Max 5)</h2>
        <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-hide">
          <!-- Slot 1 (Filled) -->
          <div class="relative flex-shrink-0">
            <div
              class="size-24 rounded-xl bg-center bg-cover border border-primary/20"
              data-alt="Professional portrait of a young man smiling"
              style="
                background-image: url(&quot;https://lh3.googleusercontent.com/aida-public/AB6AXuC-POGrUdG0PbItom-lYA9_Y_HBpo8aggpYqD95cSPPJ8IVJFXfKq_7fNEhVKdKEpTLYSS7RwZvdul14hriF40Sl1r84a6M15hCBJFtOfsGqPgRSTMbZkmOxcvrHnybwkFSA-HC16xIynImODYeW9cw41aYy09N1z_Mnx50ZepXPXwmNoyphwrduULrHQhxLQ0pROBkBaWX1IMf5kUn5k4TaI0Q7Q7oi7xWvYFNwzCYzQpKRKLxA1E8l2S-DEOTDMwAh2o5OlzELNP4&quot;);
              "
            ></div>
            <button
              class="absolute -top-1 -right-1 bg-red-500 text-white rounded-full size-6 flex items-center justify-center border-2 border-background-light"
            >
              <span class="material-symbols-outlined text-xs">close</span>
            </button>
          </div>
          <!-- Slot 2 (Empty/Add) -->
          <button
            class="flex-shrink-0 size-24 rounded-xl border-2 border-dashed border-primary/30 bg-primary/5 flex flex-col items-center justify-center text-primary"
          >
            <span class="material-symbols-outlined text-3xl">add_a_photo</span>
          </button>
          <!-- Slot 3 -->
          <div
            class="flex-shrink-0 size-24 rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400"
          >
            <span class="material-symbols-outlined">add</span>
          </div>
          <!-- Slot 4 -->
          <div
            class="flex-shrink-0 size-24 rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400"
          >
            <span class="material-symbols-outlined">add</span>
          </div>
          <!-- Slot 5 -->
          <div
            class="flex-shrink-0 size-24 rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400"
          >
            <span class="material-symbols-outlined">add</span>
          </div>
        </div>
      </section>
      <!-- Personal Details Section -->
      <section class="p-4 space-y-4">
        <h2 class="text-base font-bold text-primary">Personal Details</h2>
        <div class="space-y-4">
          <label class="block">
            <span class="text-sm font-medium mb-1 block">Full Name</span>
            <input
              class="w-full h-12 px-4 rounded-lg border-primary/20 bg-white dark:bg-slate-900 focus:ring-primary focus:border-primary"
              placeholder="e.g. Rahul Sharma"
              type="text"
            />
          </label>
          <div class="grid grid-cols-2 gap-4">
            <label class="block">
              <span class="text-sm font-medium mb-1 block">Date of Birth</span>
              <input
                class="w-full h-12 px-4 rounded-lg border-primary/20 bg-white dark:bg-slate-900 focus:ring-primary focus:border-primary"
                type="date"
              />
            </label>
            <label class="block">
              <span class="text-sm font-medium mb-1 block">Gender</span>
              <select
                class="w-full h-12 px-4 rounded-lg border-primary/20 bg-white dark:bg-slate-900 focus:ring-primary focus:border-primary"
              >
                <option>Male</option>
                <option>Female</option>
                <option>Other</option>
              </select>
            </label>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <label class="block">
              <span class="text-sm font-medium mb-1 block">Height</span>
              <input
                class="w-full h-12 px-4 rounded-lg border-primary/20 bg-white dark:bg-slate-900 focus:ring-primary focus:border-primary"
                placeholder="5' 7\"
                type="text"
              />
            </label>
            <label class="block">
              <span class="text-sm font-medium mb-1 block"
                >Religion / Caste</span
              >
              <input
                class="w-full h-12 px-4 rounded-lg border-primary/20 bg-slate-100 dark:bg-slate-800 focus:ring-primary focus:border-primary"
                readonly=""
                type="text"
                value="Hindu / Cobbler Community"
              />
            </label>
          </div>
        </div>
      </section>
      <!-- Professional Details Section -->
      <section class="p-4 space-y-4">
        <h2 class="text-base font-bold text-primary">
          Professional &amp; Educational
        </h2>
        <div class="space-y-4">
          <label class="block">
            <span class="text-sm font-medium mb-1 block"
              >Highest Education</span
            >
            <select
              class="w-full h-12 px-4 rounded-lg border-primary/20 bg-white dark:bg-slate-900 focus:ring-primary focus:border-primary"
            >
              <option>Bachelor's Degree</option>
              <option>Master's Degree</option>
              <option>Doctorate</option>
              <option>High School</option>
              <option>Other Professional Course</option>
            </select>
          </label>
          <label class="block">
            <span class="text-sm font-medium mb-1 block"
              >Occupation / Profession</span
            >
            <input
              class="w-full h-12 px-4 rounded-lg border-primary/20 bg-white dark:bg-slate-900 focus:ring-primary focus:border-primary"
              placeholder="e.g. Software Engineer"
              type="text"
            />
          </label>
          <label class="block">
            <span class="text-sm font-medium mb-1 block"
              >Annual Income (Optional)</span
            >
            <input
              class="w-full h-12 px-4 rounded-lg border-primary/20 bg-white dark:bg-slate-900 focus:ring-primary focus:border-primary"
              placeholder="e.g. ₹ 8,00,000"
              type="text"
            />
          </label>
        </div>
      </section>
      <!-- Location Details -->
      <section class="p-4 space-y-4">
        <h2 class="text-base font-bold text-primary">Location</h2>
        <div class="grid grid-cols-2 gap-4">
          <label class="block">
            <span class="text-sm font-medium mb-1 block">Current City</span>
            <input
              class="w-full h-12 px-4 rounded-lg border-primary/20 bg-white dark:bg-slate-900 focus:ring-primary focus:border-primary"
              placeholder="e.g. Mumbai"
              type="text"
            />
          </label>
          <label class="block">
            <span class="text-sm font-medium mb-1 block">State</span>
            <input
              class="w-full h-12 px-4 rounded-lg border-primary/20 bg-white dark:bg-slate-900 focus:ring-primary focus:border-primary"
              placeholder="e.g. Maharashtra"
              type="text"
            />
          </label>
        </div>
      </section>
      <!-- About Me Section -->
      <section class="p-4 space-y-4">
        <h2 class="text-base font-bold text-primary">About Me / Bio</h2>
        <label class="block">
          <textarea
            class="w-full p-4 rounded-xl border-primary/20 bg-white dark:bg-slate-900 focus:ring-primary focus:border-primary resize-none"
            placeholder="Tell us about yourself, your hobbies, and what you're looking for..."
            rows="4"
          ></textarea>
        </label>
      </section>
      <!-- Privacy Toggle -->
      <section class="p-4">
        <div
          class="flex items-center justify-between p-4 rounded-xl bg-primary/5 border border-primary/10"
        >
          <div class="flex-1 pr-4">
            <p class="text-sm font-semibold">Contact Privacy</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              Hide contact details until approval
            </p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input checked="" class="sr-only peer" type="checkbox" value="" />
            <div
              class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-primary"
            ></div>
          </label>
        </div>
      </section>
    </main>
    <!-- Bottom Action Button -->
    <div
      class="fixed bottom-0 left-0 right-0 p-4 bg-background-light/95 dark:bg-background-dark/95 backdrop-blur-md border-t border-primary/10 max-w-md mx-auto"
    >
      <button
        class="w-full bg-primary text-white font-bold py-4 rounded-xl shadow-lg shadow-primary/20 hover:bg-primary/90 transition-colors flex items-center justify-center gap-2"
      >
        <span>Create Profile</span>
        <span class="material-symbols-outlined">chevron_right</span>
      </button>
    </div>
  </body>
</html>
