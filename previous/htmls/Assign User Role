<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#f2780d",
              "background-light": "#f8f7f5",
              "background-dark": "#221810",
            },
            fontFamily: {
              display: ["Public Sans"],
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              full: "9999px",
            },
          },
        },
      };
    </script>
    <title>Assign Role - Indian Cobbler Community</title>
    <style>
      body {
        min-height: max(884px, 100dvh);
      }
    </style>
  </head>
  <body
    class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 min-h-screen"
  >
    <div
      class="relative flex h-auto min-h-screen w-full flex-col bg-background-light dark:bg-background-dark group/design-root overflow-x-hidden"
    >
      <!-- Top Navigation Bar -->
      <div
        class="flex items-center bg-background-light dark:bg-background-dark p-4 pb-2 justify-between border-b border-primary/10"
      >
        <div
          class="text-primary flex size-12 shrink-0 items-center justify-start cursor-pointer"
        >
          <span class="material-symbols-outlined text-[28px]">arrow_back</span>
        </div>
        <h2
          class="text-slate-900 dark:text-slate-100 text-lg font-bold leading-tight tracking-[-0.015em] flex-1 text-center pr-12"
        >
          Assign Role
        </h2>
      </div>
      <!-- User Profile Summary Card -->
      <div class="flex p-6 @container">
        <div
          class="flex w-full flex-col gap-6 items-center bg-white dark:bg-background-dark/50 rounded-xl p-6 shadow-sm border border-primary/5"
        >
          <div class="flex gap-4 flex-col items-center">
            <div
              class="bg-center bg-no-repeat aspect-square bg-cover rounded-full ring-4 ring-primary/10 min-h-32 w-32"
              data-alt="Close up portrait of an Indian man smiling"
              style="
                background-image: url(&quot;https://lh3.googleusercontent.com/aida-public/AB6AXuB3bvnvBCxMXGYEiv9uuhhTXTqP2nf3lLeubnVbySoS3JfKFh44aR8nHlNqJQTXvblEriat36XLnJDz13ItzhXw_AX9uogTIUDa6TeOum3J6keaRrrwKyfj1PozvlTWMtue7PXVTsz7U5pflNyx9s1LcWWSXzUojLM2bKV_dN5DtIY6xj9BXFPuOlFQX4EJMzZorpSmlzefRhWZvLcocodY_XAPZSm2U8xajiNKfUOZu68m7wOfWf3QMsI1sVYOoV42fx4-lH1itMZE&quot;);
              "
            ></div>
            <div class="flex flex-col items-center justify-center">
              <p
                class="text-slate-900 dark:text-slate-100 text-[24px] font-bold leading-tight tracking-[-0.015em] text-center"
              >
                Rajesh Kumar
              </p>
              <p class="text-primary font-semibold text-sm mt-1">
                ID: IC-2024-0891
              </p>
              <div class="mt-2 px-3 py-1 bg-primary/10 rounded-full">
                <p
                  class="text-primary text-xs font-bold uppercase tracking-wider"
                >
                  Current Role: Member
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Role Selection Section -->
      <div class="px-4 py-2">
        <h3
          class="text-slate-900 dark:text-slate-100 text-lg font-bold leading-tight tracking-[-0.015em] mb-4"
        >
          Select New Role
        </h3>
        <div class="flex flex-col gap-4">
          <!-- Role: Trustee -->
          <label
            class="flex items-center gap-4 rounded-xl border-2 border-primary/20 bg-white dark:bg-background-dark/40 p-5 cursor-pointer hover:border-primary transition-colors group"
          >
            <div class="flex items-center justify-center">
              <input
                class="h-6 w-6 border-2 border-primary/30 bg-transparent text-primary focus:ring-primary focus:ring-offset-0 checked:bg-primary"
                name="role-selection"
                type="radio"
                value="trustee"
              />
            </div>
            <div class="flex grow flex-col">
              <div class="flex items-center gap-2 mb-1">
                <span class="material-symbols-outlined text-primary text-xl"
                  >verified_user</span
                >
                <p
                  class="text-slate-900 dark:text-slate-100 text-base font-bold"
                >
                  Trustee
                </p>
              </div>
              <p
                class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed"
              >
                Full administrative access. Can manage community funds, approve
                new members, and organize regional events.
              </p>
            </div>
          </label>
          <!-- Role: Member -->
          <label
            class="flex items-center gap-4 rounded-xl border-2 border-primary/20 bg-white dark:bg-background-dark/40 p-5 cursor-pointer hover:border-primary transition-colors group"
          >
            <div class="flex items-center justify-center">
              <input
                checked=""
                class="h-6 w-6 border-2 border-primary/30 bg-transparent text-primary focus:ring-primary focus:ring-offset-0 checked:bg-primary"
                name="role-selection"
                type="radio"
                value="member"
              />
            </div>
            <div class="flex grow flex-col">
              <div class="flex items-center gap-2 mb-1">
                <span class="material-symbols-outlined text-primary text-xl"
                  >person</span
                >
                <p
                  class="text-slate-900 dark:text-slate-100 text-base font-bold"
                >
                  Member
                </p>
              </div>
              <p
                class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed"
              >
                Standard access to community forums, basic training resources,
                job listings, and member benefit programs.
              </p>
            </div>
          </label>
          <!-- Role: Support (Optional additional role for UI completeness) -->
          <label
            class="flex items-center gap-4 rounded-xl border-2 border-primary/20 bg-white dark:bg-background-dark/40 p-5 cursor-pointer hover:border-primary transition-colors group"
          >
            <div class="flex items-center justify-center">
              <input
                class="h-6 w-6 border-2 border-primary/30 bg-transparent text-primary focus:ring-primary focus:ring-offset-0 checked:bg-primary"
                name="role-selection"
                type="radio"
                value="support"
              />
            </div>
            <div class="flex grow flex-col">
              <div class="flex items-center gap-2 mb-1">
                <span class="material-symbols-outlined text-primary text-xl"
                  >help_center</span
                >
                <p
                  class="text-slate-900 dark:text-slate-100 text-base font-bold"
                >
                  Community Support
                </p>
              </div>
              <p
                class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed"
              >
                Can assist members with technical issues and moderate community
                discussions without financial access.
              </p>
            </div>
          </label>
        </div>
      </div>
      <!-- Action Button -->
      <div class="mt-auto px-4 py-8">
        <button
          class="flex w-full cursor-pointer items-center justify-center overflow-hidden rounded-xl h-14 px-5 bg-primary text-white text-base font-bold leading-normal tracking-[0.015em] shadow-lg shadow-primary/20 hover:bg-primary/90 active:scale-[0.98] transition-all"
        >
          <span class="truncate">Save Changes</span>
        </button>
        <p class="text-center text-slate-500 dark:text-slate-500 text-xs mt-4">
          The user will be notified of their new role via SMS and App
          Notification.
        </p>
      </div>
      <div class="h-5 bg-background-light dark:bg-background-dark"></div>
    </div>
  </body>
</html>
