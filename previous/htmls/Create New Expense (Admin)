<!DOCTYPE html>

<html class="light" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Create New Expense - Indian Cobbler Community</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#f2780d",
              "background-light": "#f8f7f5",
              "background-dark": "#221810",
            },
            fontFamily: {
              display: ["Public Sans", "sans-serif"],
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              full: "9999px",
            },
          },
        },
      };
    </script>
    <style>
      body {
        min-height: max(884px, 100dvh);
      }
    </style>
  </head>
  <body
    class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100"
  >
    <div
      class="relative flex min-h-screen w-full flex-col max-w-md mx-auto bg-background-light dark:bg-background-dark shadow-xl"
    >
      <!-- Header -->
      <div
        class="sticky top-0 z-10 flex items-center bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-md p-4 border-b border-primary/10"
      >
        <button
          class="text-slate-900 dark:text-slate-100 flex size-10 shrink-0 items-center justify-center rounded-full hover:bg-primary/10 transition-colors"
        >
          <span class="material-symbols-outlined">arrow_back</span>
        </button>
        <h2 class="ml-2 text-lg font-bold leading-tight tracking-tight flex-1">
          Create New Expense
        </h2>
      </div>
      <!-- Form Content -->
      <div class="flex-1 overflow-y-auto pb-24">
        <form class="flex flex-col gap-5 p-4">
          <!-- Expense Amount -->
          <div class="flex flex-col gap-2">
            <label
              class="text-sm font-semibold text-slate-700 dark:text-slate-300"
              >Expense Amount</label
            >
            <div class="flex w-full items-stretch group">
              <div
                class="flex items-center justify-center px-4 bg-primary/10 border border-primary/20 border-r-0 rounded-l-lg text-primary font-bold"
              >
                ₹
              </div>
              <input
                class="flex-1 border border-primary/20 bg-white dark:bg-slate-800 rounded-r-lg px-4 py-3 focus:ring-2 focus:ring-primary focus:border-primary outline-none text-lg font-medium"
                placeholder="0.00"
                step="0.01"
                type="number"
              />
            </div>
          </div>
          <!-- Vendor Name -->
          <div class="flex flex-col gap-2">
            <label
              class="text-sm font-semibold text-slate-700 dark:text-slate-300"
              >Vendor / Payee Name</label
            >
            <input
              class="w-full border border-primary/20 bg-white dark:bg-slate-800 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary focus:border-primary outline-none"
              placeholder="e.g. Ramesh Catering Services"
              type="text"
            />
          </div>
          <!-- Date of Expense -->
          <div class="flex flex-col gap-2">
            <label
              class="text-sm font-semibold text-slate-700 dark:text-slate-300"
              >Date of Expense</label
            >
            <div class="relative">
              <input
                class="w-full border border-primary/20 bg-white dark:bg-slate-800 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary focus:border-primary outline-none appearance-none"
                type="date"
              />
            </div>
          </div>
          <!-- Expense Category -->
          <div class="flex flex-col gap-2">
            <label
              class="text-sm font-semibold text-slate-700 dark:text-slate-300"
              >Expense Category</label
            >
            <div class="relative">
              <select
                class="w-full border border-primary/20 bg-white dark:bg-slate-800 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary focus:border-primary outline-none appearance-none"
              >
                <option value="">Select Category</option>
                <option value="venue">Venue</option>
                <option value="catering">Catering</option>
                <option value="marketing">Marketing</option>
                <option value="charity">Charity</option>
                <option value="logistics">Logistics</option>
                <option value="others">Others</option>
              </select>
              <span
                class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400"
                >expand_more</span
              >
            </div>
          </div>
          <!-- Event Link -->
          <div class="flex flex-col gap-2">
            <label
              class="text-sm font-semibold text-slate-700 dark:text-slate-300"
              >Link to Event</label
            >
            <div class="relative">
              <select
                class="w-full border border-primary/20 bg-white dark:bg-slate-800 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary focus:border-primary outline-none appearance-none"
              >
                <option value="gen_ops">General Operations</option>
                <option value="delhi_meet">National Meetup Delhi</option>
                <option value="annual_workshop">Annual Workshop</option>
              </select>
              <span
                class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400"
                >event</span
              >
            </div>
          </div>
          <!-- Payment Mode -->
          <div class="flex flex-col gap-2">
            <label
              class="text-sm font-semibold text-slate-700 dark:text-slate-300"
              >Payment Mode</label
            >
            <div class="flex gap-2">
              <label class="flex-1 cursor-pointer">
                <input
                  checked=""
                  class="hidden peer"
                  name="payment"
                  type="radio"
                />
                <div
                  class="flex flex-col items-center justify-center p-3 border border-primary/20 rounded-lg bg-white dark:bg-slate-800 peer-checked:bg-primary/10 peer-checked:border-primary peer-checked:text-primary transition-all"
                >
                  <span class="material-symbols-outlined mb-1">payments</span>
                  <span class="text-xs font-medium">Cash</span>
                </div>
              </label>
              <label class="flex-1 cursor-pointer">
                <input class="hidden peer" name="payment" type="radio" />
                <div
                  class="flex flex-col items-center justify-center p-3 border border-primary/20 rounded-lg bg-white dark:bg-slate-800 peer-checked:bg-primary/10 peer-checked:border-primary peer-checked:text-primary transition-all"
                >
                  <span class="material-symbols-outlined mb-1"
                    >account_balance</span
                  >
                  <span class="text-xs font-medium">Bank</span>
                </div>
              </label>
              <label class="flex-1 cursor-pointer">
                <input class="hidden peer" name="payment" type="radio" />
                <div
                  class="flex flex-col items-center justify-center p-3 border border-primary/20 rounded-lg bg-white dark:bg-slate-800 peer-checked:bg-primary/10 peer-checked:border-primary peer-checked:text-primary transition-all"
                >
                  <span class="material-symbols-outlined mb-1"
                    >description</span
                  >
                  <span class="text-xs font-medium">Cheque</span>
                </div>
              </label>
            </div>
          </div>
          <!-- Description/Notes -->
          <div class="flex flex-col gap-2">
            <label
              class="text-sm font-semibold text-slate-700 dark:text-slate-300"
              >Description / Notes</label
            >
            <textarea
              class="w-full border border-primary/20 bg-white dark:bg-slate-800 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary focus:border-primary outline-none"
              placeholder="Add additional details about the expense..."
              rows="3"
            ></textarea>
          </div>
          <!-- Upload Receipt -->
          <div class="flex flex-col gap-2">
            <label
              class="text-sm font-semibold text-slate-700 dark:text-slate-300"
              >Upload Receipt</label
            >
            <div
              class="border-2 border-dashed border-primary/30 bg-primary/5 rounded-xl p-8 flex flex-col items-center justify-center text-center cursor-pointer hover:bg-primary/10 transition-colors"
            >
              <div
                class="size-12 rounded-full bg-primary/20 text-primary flex items-center justify-center mb-3"
              >
                <span class="material-symbols-outlined">add_a_photo</span>
              </div>
              <p class="text-sm font-medium">Click to upload photo or PDF</p>
              <p class="text-xs text-slate-500 mt-1">Max file size: 5MB</p>
            </div>
          </div>
        </form>
      </div>
      <!-- Action Buttons Footer -->
      <div
        class="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-white/90 dark:bg-slate-900/90 backdrop-blur-md p-4 flex gap-3 border-t border-primary/10"
      >
        <button
          class="flex-1 px-6 py-3 border border-primary/30 text-primary font-bold rounded-xl hover:bg-primary/5 transition-colors"
        >
          Cancel
        </button>
        <button
          class="flex-[2] px-6 py-3 bg-primary text-white font-bold rounded-xl shadow-lg shadow-primary/20 hover:bg-primary/90 transition-colors"
        >
          Save Expense
        </button>
      </div>
      <!-- Bottom Navigation (Partial View for Context) -->
      <div class="hidden">
        <!-- Included in the structure but hidden as the user prompt focused on the form and action buttons -->
        <div
          class="flex gap-2 border-t border-primary/10 bg-background-light px-4 pb-3 pt-2"
        >
          <a
            class="flex flex-1 flex-col items-center justify-end gap-1 text-primary/60"
            href="#"
          >
            <span class="material-symbols-outlined">house</span>
            <p class="text-xs font-medium">Home</p>
          </a>
          <a
            class="flex flex-1 flex-col items-center justify-end gap-1 text-primary"
            href="#"
          >
            <span class="material-symbols-outlined fill-1">receipt_long</span>
            <p class="text-xs font-medium">Expenses</p>
          </a>
          <a
            class="flex flex-1 flex-col items-center justify-end gap-1 text-primary/60"
            href="#"
          >
            <span class="material-symbols-outlined">calendar_today</span>
            <p class="text-xs font-medium">Events</p>
          </a>
          <a
            class="flex flex-1 flex-col items-center justify-end gap-1 text-primary/60"
            href="#"
          >
            <span class="material-symbols-outlined">person</span>
            <p class="text-xs font-medium">Profile</p>
          </a>
        </div>
      </div>
    </div>
  </body>
</html>
