              "on-tertiary-container": "#56c6bc",
              "on-error": "#ffffff",
              "surface-dim": "#ddd9d6",
              "on-background": "#1c1b1a",
              "on-surface": "#1c1b1a",
              background: "#fdf9f6",
              "on-tertiary": "#ffffff",
              "on-secondary": "#ffffff",
              "on-primary-container": "#d9ab9b",
              "surface-tint": "#7a5649",
              "surface-container-high": "#ebe7e4",
              "primary-fixed": "#ffdbcf",
              "secondary-container": "#ff8928",
              secondary: "#964900",
              "on-secondary-fixed-variant": "#723600",
              "secondary-fixed": "#ffdcc6",
              "primary-container": "#603f33",
              "on-tertiary-fixed": "#00201d",
              "on-primary-fixed": "#2e150b",
              "surface-container-highest": "#e5e2df",
              "on-primary": "#ffffff",
