<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Expense Management - Indian Cobbler Community</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#f2780d",
              "background-light": "#f8f7f5",
              "background-dark": "#221810",
            },
            fontFamily: {
              display: ["Public Sans"],
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              full: "9999px",
            },
          },
        },
      };
    </script>
    <style>
      body {
        font-family: "Public Sans", sans-serif;
      }
      .material-symbols-outlined {
        font-variation-settings:
          "FILL" 0,
          "wght" 400,
          "GRAD" 0,
          "opsz" 24;
      }
    </style>
    <style>
      body {
        min-height: max(884px, 100dvh);
      }
    </style>
  </head>
  <body
    class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen"
  >
    <div class="relative flex min-h-screen w-full flex-col overflow-x-hidden">
      <!-- Header -->
      <header
        class="flex items-center bg-background-light dark:bg-background-dark p-4 border-b border-primary/10 sticky top-0 z-10"
      >
        <div
          class="text-slate-900 dark:text-slate-100 flex size-12 shrink-0 items-center justify-center cursor-pointer"
        >
          <span class="material-symbols-outlined">arrow_back</span>
        </div>
        <h1
          class="text-slate-900 dark:text-slate-100 text-lg font-bold leading-tight tracking-tight flex-1 ml-2"
        >
          Expense Management
        </h1>
        <div class="flex gap-2">
          <button
            class="flex size-10 items-center justify-center rounded-lg bg-primary/10 text-primary"
          >
            <span class="material-symbols-outlined">search</span>
          </button>
          <button
            class="flex size-10 items-center justify-center rounded-lg bg-primary/10 text-primary"
          >
            <span class="material-symbols-outlined">notifications</span>
          </button>
        </div>
      </header>
      <main class="flex-1 pb-24">
        <!-- Summary Section -->
        <div class="flex flex-wrap gap-4 p-4">
          <div
            class="flex min-w-[158px] flex-1 flex-col gap-2 rounded-xl p-5 border border-primary/20 bg-white dark:bg-slate-800 shadow-sm"
          >
            <div class="flex items-center gap-2 text-primary">
              <span class="material-symbols-outlined text-xl"
                >account_balance_wallet</span
              >
              <p class="text-slate-600 dark:text-slate-400 text-sm font-medium">
                Total Monthly Expenses
              </p>
            </div>
            <p
              class="text-slate-900 dark:text-white tracking-tight text-2xl font-bold"
            >
              ₹45,800
            </p>
            <div class="flex items-center gap-1">
              <span class="material-symbols-outlined text-green-600 text-sm"
                >trending_up</span
              >
              <p class="text-green-600 text-xs font-semibold">
                +5.2% vs last month
              </p>
            </div>
          </div>
          <div
            class="flex min-w-[158px] flex-1 flex-col gap-2 rounded-xl p-5 border border-primary/20 bg-white dark:bg-slate-800 shadow-sm"
          >
            <div class="flex items-center gap-2 text-primary">
              <span class="material-symbols-outlined text-xl"
                >pending_actions</span
              >
              <p class="text-slate-600 dark:text-slate-400 text-sm font-medium">
                Pending Reconciliations
              </p>
            </div>
            <p
              class="text-slate-900 dark:text-white tracking-tight text-2xl font-bold"
            >
              12
            </p>
            <div class="flex items-center gap-1">
              <span class="material-symbols-outlined text-primary text-sm"
                >priority_high</span
              >
              <p class="text-primary text-xs font-semibold">
                Requires attention
              </p>
            </div>
          </div>
        </div>
        <!-- Filters -->
        <div class="px-4 py-2">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-slate-900 dark:text-slate-100 text-base font-bold">
              Filters
            </h3>
            <button class="text-primary text-sm font-semibold">
              Clear All
            </button>
          </div>
          <div class="flex gap-2 overflow-x-auto pb-2 no-scrollbar">
            <button
              class="flex h-9 shrink-0 items-center justify-center gap-x-2 rounded-full bg-primary/10 border border-primary/20 px-4"
            >
              <span class="material-symbols-outlined text-primary text-sm"
                >calendar_today</span
              >
              <p class="text-slate-800 dark:text-slate-200 text-sm font-medium">
                Oct 2023
              </p>
              <span class="material-symbols-outlined text-slate-400 text-sm"
                >keyboard_arrow_down</span
              >
            </button>
            <button
              class="flex h-9 shrink-0 items-center justify-center gap-x-2 rounded-full bg-primary/10 border border-primary/20 px-4"
            >
              <span class="material-symbols-outlined text-primary text-sm"
                >category</span
              >
              <p class="text-slate-800 dark:text-slate-200 text-sm font-medium">
                Category
              </p>
              <span class="material-symbols-outlined text-slate-400 text-sm"
                >keyboard_arrow_down</span
              >
            </button>
            <button
              class="flex h-9 shrink-0 items-center justify-center gap-x-2 rounded-full bg-primary/10 border border-primary/20 px-4"
            >
              <span class="material-symbols-outlined text-primary text-sm"
                >event</span
              >
              <p class="text-slate-800 dark:text-slate-200 text-sm font-medium">
                Event
              </p>
              <span class="material-symbols-outlined text-slate-400 text-sm"
                >keyboard_arrow_down</span
              >
            </button>
          </div>
        </div>
        <!-- Expenses List -->
        <div class="px-4 pt-4">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-slate-900 dark:text-slate-100 text-base font-bold">
              Recent Expenses
            </h3>
            <span class="text-slate-500 text-xs font-medium"
              >Showing 24 entries</span
            >
          </div>
          <div class="space-y-3">
            <!-- Expense Item 1 -->
            <div
              class="flex items-center justify-between p-4 rounded-xl border border-primary/10 bg-white dark:bg-slate-800/50"
            >
              <div class="flex items-center gap-3">
                <div
                  class="size-10 rounded-lg bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center text-primary"
                >
                  <span class="material-symbols-outlined">campaign</span>
                </div>
                <div>
                  <p
                    class="text-slate-900 dark:text-slate-100 font-bold text-sm"
                  >
                    Social Media Ads
                  </p>
                  <p class="text-slate-500 text-xs">Marketing • Oct 24, 2023</p>
                  <p class="text-primary/70 text-[10px] font-medium mt-1">
                    Event: Diwali Artisans Meet
                  </p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-slate-900 dark:text-slate-100 font-bold">
                  ₹2,450
                </p>
                <span
                  class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-[10px] font-medium text-green-700"
                  >Paid</span
                >
              </div>
            </div>
            <!-- Expense Item 2 -->
            <div
              class="flex items-center justify-between p-4 rounded-xl border border-primary/10 bg-white dark:bg-slate-800/50"
            >
              <div class="flex items-center gap-3">
                <div
                  class="size-10 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600"
                >
                  <span class="material-symbols-outlined">restaurant</span>
                </div>
                <div>
                  <p
                    class="text-slate-900 dark:text-slate-100 font-bold text-sm"
                  >
                    Catering Services
                  </p>
                  <p class="text-slate-500 text-xs">Catering • Oct 22, 2023</p>
                  <p class="text-slate-400 text-[10px] font-medium mt-1">
                    General Operations
                  </p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-slate-900 dark:text-slate-100 font-bold">
                  ₹15,000
                </p>
                <span
                  class="inline-flex items-center rounded-full bg-yellow-100 px-2 py-0.5 text-[10px] font-medium text-yellow-700"
                  >Pending</span
                >
              </div>
            </div>
            <!-- Expense Item 3 -->
            <div
              class="flex items-center justify-between p-4 rounded-xl border border-primary/10 bg-white dark:bg-slate-800/50"
            >
              <div class="flex items-center gap-3">
                <div
                  class="size-10 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600"
                >
                  <span class="material-symbols-outlined">location_on</span>
                </div>
                <div>
                  <p
                    class="text-slate-900 dark:text-slate-100 font-bold text-sm"
                  >
                    Hall Rental Deposit
                  </p>
                  <p class="text-slate-500 text-xs">Venue • Oct 20, 2023</p>
                  <p class="text-primary/70 text-[10px] font-medium mt-1">
                    Event: Annual Workshop
                  </p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-slate-900 dark:text-slate-100 font-bold">
                  ₹8,000
                </p>
                <span
                  class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-[10px] font-medium text-green-700"
                  >Paid</span
                >
              </div>
            </div>
          </div>
          <button
            class="w-full mt-6 py-3 text-primary font-semibold text-sm bg-primary/5 rounded-xl border border-dashed border-primary/30"
          >
            View All Transaction History
          </button>
        </div>
      </main>
      <!-- Floating Action Button -->
      <button
        class="fixed right-6 bottom-24 size-14 rounded-full bg-primary text-white shadow-lg shadow-primary/40 flex items-center justify-center z-20"
      >
        <span class="material-symbols-outlined text-3xl">add</span>
      </button>
      <!-- Form Section Placeholder (Hidden for now, logic would trigger it) -->
      <div class="hidden fixed inset-0 bg-black/50 z-50 flex items-end">
        <div
          class="bg-background-light dark:bg-background-dark w-full rounded-t-3xl p-6 space-y-4"
        >
          <div class="w-12 h-1 bg-slate-300 rounded-full mx-auto mb-2"></div>
          <h2 class="text-xl font-bold">Add New Expense</h2>
          <div class="grid grid-cols-1 gap-4">
            <div class="space-y-1">
              <label
                class="text-sm font-semibold text-slate-600 dark:text-slate-400"
                >Category</label
              >
              <select
                class="w-full rounded-lg border-primary/20 bg-white dark:bg-slate-800 focus:ring-primary"
              >
                <option>Venue</option>
                <option>Catering</option>
                <option>Marketing</option>
                <option>Travel</option>
              </select>
            </div>
            <div class="space-y-1">
              <label
                class="text-sm font-semibold text-slate-600 dark:text-slate-400"
                >Amount (₹)</label
              >
              <input
                class="w-full rounded-lg border-primary/20 bg-white dark:bg-slate-800 focus:ring-primary"
                placeholder="0.00"
                type="number"
              />
            </div>
            <div class="space-y-1">
              <label
                class="text-sm font-semibold text-slate-600 dark:text-slate-400"
                >Payment Method</label
              >
              <div class="flex gap-2">
                <button
                  class="flex-1 py-2 rounded-lg border border-primary bg-primary/10 text-primary text-xs font-bold"
                >
                  UPI
                </button>
                <button
                  class="flex-1 py-2 rounded-lg border border-primary/20 text-slate-600 text-xs font-bold"
                >
                  Cash
                </button>
                <button
                  class="flex-1 py-2 rounded-lg border border-primary/20 text-slate-600 text-xs font-bold"
                >
                  Bank Transfer
                </button>
              </div>
            </div>
          </div>
          <button
            class="w-full bg-primary text-white py-4 rounded-xl font-bold shadow-lg shadow-primary/20"
          >
            Save Expense
          </button>
        </div>
      </div>
      <!-- Bottom Navigation -->
      <nav
        class="fixed bottom-0 left-0 right-0 border-t border-primary/10 bg-background-light dark:bg-background-dark px-4 pb-3 pt-2 flex items-center justify-around z-30"
      >
        <a class="flex flex-col items-center gap-1 text-slate-400" href="#">
          <span class="material-symbols-outlined">dashboard</span>
          <p class="text-xs font-medium">Dashboard</p>
        </a>
        <a class="flex flex-col items-center gap-1 text-primary" href="#">
          <span
            class="material-symbols-outlined"
            style="font-variation-settings: &quot;FILL&quot; 1"
            >receipt_long</span
          >
          <p class="text-xs font-medium">Expenses</p>
        </a>
        <a class="flex flex-col items-center gap-1 text-slate-400" href="#">
          <span class="material-symbols-outlined">calendar_month</span>
          <p class="text-xs font-medium">Events</p>
        </a>
        <a class="flex flex-col items-center gap-1 text-slate-400" href="#">
          <span class="material-symbols-outlined">settings</span>
          <p class="text-xs font-medium">Settings</p>
        </a>
      </nav>
    </div>
  </body>
</html>
