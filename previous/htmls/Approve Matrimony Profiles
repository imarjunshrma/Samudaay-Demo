<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#f2780d",
              "background-light": "#f8f7f5",
              "background-dark": "#221810",
            },
            fontFamily: {
              display: ["Public Sans"],
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              full: "9999px",
            },
          },
        },
      };
    </script>
    <title>Admin Moderation - Indian Cobbler Community</title>
    <style>
      body {
        min-height: max(884px, 100dvh);
      }
    </style>
  </head>
  <body
    class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 min-h-screen"
  >
    <!-- Header -->
    <header
      class="sticky top-0 z-50 bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-md border-b border-primary/10"
    >
      <div class="flex items-center justify-between p-4 max-w-2xl mx-auto">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary cursor-pointer"
            >arrow_back</span
          >
          <h1 class="text-xl font-bold tracking-tight">Profile Moderation</h1>
        </div>
        <button class="p-2 hover:bg-primary/10 rounded-full transition-colors">
          <span
            class="material-symbols-outlined text-slate-700 dark:text-slate-300"
            >filter_list</span
          >
        </button>
      </div>
    </header>
    <main class="max-w-2xl mx-auto pb-24">
      <!-- Stats & Filters -->
      <div class="p-4 flex flex-col gap-4">
        <div class="flex items-center justify-between">
          <h2
            class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"
          >
            Pending Review (12)
          </h2>
          <div class="flex gap-2">
            <button
              class="flex items-center gap-1 px-3 py-1.5 bg-primary text-white text-xs font-medium rounded-full"
            >
              Newest
              <span class="material-symbols-outlined text-xs">expand_more</span>
            </button>
            <button
              class="flex items-center gap-1 px-3 py-1.5 bg-primary/10 text-primary text-xs font-medium rounded-full"
            >
              Urgent
              <span class="material-symbols-outlined text-xs text-primary"
                >priority_high</span
              >
            </button>
          </div>
        </div>
      </div>
      <!-- Moderation Cards List -->
      <div class="flex flex-col gap-6 px-4">
        <!-- Profile Card 1 -->
        <div
          class="bg-white dark:bg-slate-800 rounded-xl overflow-hidden shadow-sm border border-slate-200 dark:border-slate-700"
        >
          <!-- Image Carousel Placeholder -->
          <div class="relative group">
            <div
              class="aspect-[4/5] bg-slate-100 dark:bg-slate-900 overflow-hidden"
            >
              <img
                alt="Profile Photo"
                class="w-full h-full object-cover"
                data-alt="Close up portrait of a young Indian man"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuAJrEnOvnXHiWthC_ybWGT86lgbRBg2fnynl9YBbvP31vSwkJV8BtLgel842eIJCfmWtS_DYoPJm90hnEXpxSzLHInSO1PVv0BNNygPzDiKhKfPJYCjJsXSqVDWfGJT4Z4zh3vBm6nMJ66cadryaYR0UGmQ80uJHB0Kaji4RcehAm9Bm_88X3UYiGtLYyoRW5TEOKhzX7Kh63hNoI93YJvZAfD9cMgltRUrjKiQQh6Y26X1SZ27lsBhBUKWWS9e_Ce7uQm1I5skj-Zw"
              />
            </div>
            <!-- Carousel Indicators -->
            <div
              class="absolute bottom-4 left-0 right-0 flex justify-center gap-1.5"
            >
              <div class="w-8 h-1 bg-primary rounded-full"></div>
              <div class="w-2 h-1 bg-white/50 rounded-full"></div>
              <div class="w-2 h-1 bg-white/50 rounded-full"></div>
              <div class="w-2 h-1 bg-white/50 rounded-full"></div>
              <div class="w-2 h-1 bg-white/50 rounded-full"></div>
            </div>
            <div
              class="absolute top-4 right-4 bg-black/40 backdrop-blur-sm text-white text-[10px] px-2 py-1 rounded-full"
            >
              1/5 Photos
            </div>
          </div>
          <!-- Profile Info -->
          <div class="p-4">
            <div class="flex justify-between items-start mb-2">
              <div>
                <h3 class="text-lg font-bold">Rajesh Kumar, 28</h3>
                <p
                  class="text-sm text-slate-600 dark:text-slate-400 flex items-center gap-1"
                >
                  <span class="material-symbols-outlined text-xs">work</span>
                  Leather Artisan (Footwear Designer)
                </p>
                <p
                  class="text-sm text-slate-600 dark:text-slate-400 flex items-center gap-1 mt-0.5"
                >
                  <span class="material-symbols-outlined text-xs"
                    >location_on</span
                  >
                  Kanpur, Uttar Pradesh
                </p>
              </div>
            </div>
            <button
              class="w-full mt-3 py-2 border border-primary/20 text-primary text-sm font-semibold rounded-lg hover:bg-primary/5 transition-colors flex items-center justify-center gap-2"
            >
              View Full Details
              <span class="material-symbols-outlined text-sm">open_in_new</span>
            </button>
            <!-- Moderator Actions -->
            <div
              class="grid grid-cols-2 gap-3 mt-4 pt-4 border-t border-slate-100 dark:border-slate-700"
            >
              <button
                class="flex items-center justify-center gap-2 bg-red-50 text-red-600 dark:bg-red-900/20 dark:text-red-400 py-3 rounded-lg font-bold transition-all hover:bg-red-100"
              >
                <span class="material-symbols-outlined">close</span> Reject
              </button>
              <button
                class="flex items-center justify-center gap-2 bg-green-600 text-white py-3 rounded-lg font-bold transition-all hover:bg-green-700 shadow-md shadow-green-200 dark:shadow-none"
              >
                <span class="material-symbols-outlined">check</span> Approve
              </button>
            </div>
          </div>
        </div>
        <!-- Profile Card 2 - Reject State View (Reason Selection) -->
        <div
          class="bg-white dark:bg-slate-800 rounded-xl overflow-hidden shadow-sm border-2 border-red-200 dark:border-red-900/50"
        >
          <div
            class="p-4 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between bg-red-50/50 dark:bg-red-900/10"
          >
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-red-500"
                >warning</span
              >
              <span class="text-sm font-bold text-red-700 dark:text-red-400"
                >Rejecting: Sunita Chauhan</span
              >
            </div>
            <button class="material-symbols-outlined text-slate-400">
              close
            </button>
          </div>
          <div class="p-4">
            <p class="text-sm font-medium mb-3">Select Reason for Rejection:</p>
            <div class="space-y-2">
              <label
                class="flex items-center justify-between p-3 border rounded-lg cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors border-red-100 dark:border-red-900/30"
              >
                <span class="text-sm">Inappropriate content</span>
                <input
                  class="text-primary focus:ring-primary h-4 w-4"
                  name="reason"
                  type="radio"
                />
              </label>
              <label
                class="flex items-center justify-between p-3 border border-slate-200 dark:border-slate-700 rounded-lg cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors"
              >
                <span class="text-sm">Blurry/Poor quality photo</span>
                <input
                  class="text-primary focus:ring-primary h-4 w-4"
                  name="reason"
                  type="radio"
                />
              </label>
              <label
                class="flex items-center justify-between p-3 border border-slate-200 dark:border-slate-700 rounded-lg cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors"
              >
                <span class="text-sm">Incomplete profile details</span>
                <input
                  class="text-primary focus:ring-primary h-4 w-4"
                  name="reason"
                  type="radio"
                />
              </label>
              <label
                class="flex items-center justify-between p-3 border border-slate-200 dark:border-slate-700 rounded-lg cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors"
              >
                <span class="text-sm">Duplicate profile</span>
                <input
                  class="text-primary focus:ring-primary h-4 w-4"
                  name="reason"
                  type="radio"
                />
              </label>
            </div>
            <button
              class="w-full mt-4 bg-red-600 text-white py-3 rounded-lg font-bold shadow-lg shadow-red-200 dark:shadow-none"
            >
              Confirm Rejection
            </button>
          </div>
        </div>
        <!-- Profile Card 3 -->
        <div
          class="bg-white dark:bg-slate-800 rounded-xl overflow-hidden shadow-sm border border-slate-200 dark:border-slate-700 opacity-80"
        >
          <div class="relative">
            <div
              class="aspect-[4/5] bg-slate-100 dark:bg-slate-900 overflow-hidden"
            >
              <img
                alt="Profile Photo"
                class="w-full h-full object-cover"
                data-alt="Portrait of a young Indian woman in traditional attire"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuC7pygBTXktsBzMlNCPzSch1lGp3GMlMZTedCBDBM4hq-7BhiDOLnlBSRqPjI0JPnXHJ15wvd_YIwMwmxuhw3yqU5RUpokWknn0_R4CCkKIJrHkIQPhjsKpANuZZKzQyaCp1FRj1xu1X0lgDBwcoys89XubtYIfJfA0EdJ9tgTWuEA7niRRtScfupfy1kRv1nl0i9RFXEt-g7qHKlbi4cI_r6mGIVDGEpu-IchLH8mFupdO3bd4ao51zGhOizuFjfhCDBUo0xl9M0mh"
              />
            </div>
          </div>
          <div class="p-4">
            <h3 class="text-lg font-bold">Priya Verma, 25</h3>
            <p class="text-sm text-slate-600 dark:text-slate-400">
              Boutique Owner • Mumbai, MH
            </p>
            <div class="grid grid-cols-2 gap-3 mt-4">
              <button
                class="bg-red-50 text-red-600 py-3 rounded-lg font-bold text-sm"
              >
                Reject
              </button>
              <button
                class="bg-green-600 text-white py-3 rounded-lg font-bold text-sm"
              >
                Approve
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>
    <!-- Bottom Navigation Bar (Component Reference) -->
    <nav
      class="fixed bottom-0 left-0 right-0 bg-background-light dark:bg-background-dark border-t border-primary/10 px-4 pb-4 pt-2 z-50"
    >
      <div class="flex max-w-2xl mx-auto gap-2">
        <a
          class="flex flex-1 flex-col items-center justify-center gap-1 text-slate-400 dark:text-slate-500"
          href="#"
        >
          <span class="material-symbols-outlined">dashboard</span>
          <p class="text-[10px] font-medium leading-normal tracking-tight">
            Dashboard
          </p>
        </a>
        <a
          class="flex flex-1 flex-col items-center justify-center gap-1 text-slate-400 dark:text-slate-500"
          href="#"
        >
          <span class="material-symbols-outlined">group</span>
          <p class="text-[10px] font-medium leading-normal tracking-tight">
            Profiles
          </p>
        </a>
        <a
          class="flex flex-1 flex-col items-center justify-center gap-1 text-primary"
          href="#"
        >
          <span
            class="material-symbols-outlined"
            style="font-variation-settings: &quot;FILL&quot; 1"
            >shield_person</span
          >
          <p class="text-[10px] font-medium leading-normal tracking-tight">
            Moderation
          </p>
        </a>
        <a
          class="flex flex-1 flex-col items-center justify-center gap-1 text-slate-400 dark:text-slate-500"
          href="#"
        >
          <span class="material-symbols-outlined">settings</span>
          <p class="text-[10px] font-medium leading-normal tracking-tight">
            Settings
          </p>
        </a>
      </div>
    </nav>
  </body>
</html>
