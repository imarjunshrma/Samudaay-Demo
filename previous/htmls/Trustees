            </div>
            <div class="shrink-0">
              <button
                class="flex items-center justify-center rounded-lg h-9 px-4 bg-primary/10 text-primary text-sm font-bold hover:bg-primary/20 transition-colors"
              >
                <span>Contact</span>
              </button>
            </div>
          </div>
          <!-- Trustee Item 3 -->
          <div
            class="flex items-center gap-4 bg-white dark:bg-primary/5 px-4 py-5 border-y border-primary/5"
          >
            <div
              class="bg-center bg-no-repeat aspect-square bg-cover rounded-full h-16 w-16 border-2 border-primary/20 shadow-sm"
              data-alt="Professional portrait of a female Indian community leader"
              style="
                background-image: url(&quot;https://lh3.googleusercontent.com/aida-public/AB6AXuDKxSo3tAEB3wWKgTCoL7tQqriQ183NcC6N6PwX_6qLDJSRGuQRRXjZDc5u_TcRsN9omcT23eWR61ycqtJb5AKerHrPaWM9HD-8Xi6YIGmh69gFFAo5rrtiDzuzNPtnp9DcnMQn8aKuht4N3lfAN25AQ6MZQBBEG-4T3uMlITYCFpq81IA1itvxAIS8hMg6ZekynFK9YaknFSBNVdYbLePv1E1mifnm07R_RjlFCrpB-CLavQ1zelettPKxb9-qg9DbfOmG4Ru2gmwN&quot;);
              "
            ></div>
            <div class="flex flex-1 flex-col">
              <p
                class="text-slate-900 dark:text-slate-100 text-base font-bold leading-tight"
              >
                Priya More
