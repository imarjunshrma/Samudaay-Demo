              <p
                class="text-slate-900 dark:text-slate-100 text-base font-bold leading-tight"
              >
                Vikram Singh
              </p>
              <p class="text-primary text-sm font-semibold mb-1">
                Senior Advisor
              </p>
              <p
                class="text-slate-500 dark:text-slate-400 text-xs leading-normal"
              >
                40 years exp • Jodhpur, RJ
              </p>
            </div>
            <div class="shrink-0">
              <button
                class="flex items-center justify-center rounded-lg h-9 px-4 bg-primary/10 text-primary text-sm font-bold hover:bg-primary/20 transition-colors"
              >
                <span>Contact</span>
              </button>
            </div>
          </div>
        </div>
        <!-- Community Stats Card -->
        <div class="mx-4 my-8 p-5 rounded-xl bg-primary text-white shadow-lg">
          <h3 class="font-bold text-lg mb-2">Our Reach</h3>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <p
                class="text-primary-100 text-xs uppercase tracking-wider opacity-80"
              >
                Members
              </p>
              <p class="text-2xl font-bold">12,500+</p>
            </div>
            <div>
              <p
                class="text-primary-100 text-xs uppercase tracking-wider opacity-80"
              >
                Districts
              </p>
              <p class="text-2xl font-bold">48</p>
            </div>
          </div>
        </div>
      </main>
      <!-- Bottom Navigation Bar -->
      <nav
        class="fixed bottom-0 left-0 right-0 flex items-center justify-between border-t border-primary/10 bg-white/90 dark:bg-background-dark/90 backdrop-blur-md px-6 pb-6 pt-3 z-20"
      >
        <a
          class="flex flex-col items-center gap-1 text-slate-400 hover:text-primary transition-colors"
          href="#"
        >
          <span class="material-symbols-outlined text-[26px]">home</span>
          <p class="text-[10px] font-bold uppercase tracking-wider">Home</p>
        </a>
        <a class="flex flex-col items-center gap-1 text-primary" href="#">
          <span class="material-symbols-outlined text-[26px] fill-1"
            >groups</span
          >
          <p class="text-[10px] font-bold uppercase tracking-wider">
            Community
          </p>
        </a>
        <a
          class="flex flex-col items-center gap-1 text-slate-400 hover:text-primary transition-colors"
          href="#"
