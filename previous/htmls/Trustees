              "
            ></div>
            <div class="flex flex-1 flex-col">
              <p
                class="text-slate-900 dark:text-slate-100 text-base font-bold leading-tight"
              >
                Rajesh Kumar
              </p>
              <p class="text-primary text-sm font-semibold mb-1">President</p>
              <p
                class="text-slate-500 dark:text-slate-400 text-xs leading-normal"
              >
                25 years exp • Dharavi, Mumbai
              </p>
            </div>
            <div class="shrink-0">
              <button
                class="flex items-center justify-center rounded-lg h-9 px-4 bg-primary text-white text-sm font-bold shadow-md hover:bg-primary/90 transition-colors"
              >
                <span>Contact</span>
              </button>
            </div>
          </div>
          <!-- Trustee Item 2 -->
          <div
            class="flex items-center gap-4 bg-white dark:bg-primary/5 px-4 py-5 border-y border-primary/5"
          >
            <div
              class="bg-center bg-no-repeat aspect-square bg-cover rounded-full h-16 w-16 border-2 border-primary/20 shadow-sm"
