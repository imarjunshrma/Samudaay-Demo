        <div class="flex w-10 items-center justify-end">
          <button
            class="flex size-10 items-center justify-center rounded-full hover:bg-primary/10 text-slate-900 dark:text-slate-100"
          >
            <span class="material-symbols-outlined">search</span>
          </button>
        </div>
      </header>
      <!-- Main Content -->
