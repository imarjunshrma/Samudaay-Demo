        <!-- Hero Section -->
        <div class="px-4 py-6">
          <h2
            class="text-2xl font-bold text-slate-900 dark:text-slate-100 leading-tight"
          >
            Board of Trustees
          </h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm mt-1">
            Dedicated leaders serving the Indian Cobbler Community since 1985.
          </p>
        </div>
        <!-- Trustees List -->
