              "
            ></div>
            <div class="flex flex-1 flex-col">
              <p
                class="text-slate-900 dark:text-slate-100 text-base font-bold leading-tight"
              >
                Amit Shah
              </p>
              <p class="text-primary text-sm font-semibold mb-1">Secretary</p>
              <p
                class="text-slate-500 dark:text-slate-400 text-xs leading-normal"
