<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Indian Cobbler Community - Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#f2780d",
              "background-light": "#f8f7f5",
              "background-dark": "#221810",
            },
            fontFamily: {
              display: ["Public Sans", "sans-serif"],
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              full: "9999px",
            },
          },
        },
      };
    </script>
    <style>
      body {
        font-family: "Public Sans", sans-serif;
      }
      .material-symbols-outlined {
        font-variation-settings:
          "FILL" 0,
          "wght" 400,
          "GRAD" 0,
          "opsz" 24;
      }
    </style>
    <style>
      body {
        min-height: max(884px, 100dvh);
      }
    </style>
  </head>
  <body
    class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen"
  >
    <div
      class="relative flex min-h-screen w-full flex-col overflow-x-hidden pb-24"
    >
      <!-- Header -->
      <header
        class="flex items-center bg-background-light dark:bg-background-dark p-4 sticky top-0 z-10 border-b border-primary/10"
      >
        <div
          class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary"
        >
          <span class="material-symbols-outlined">analytics</span>
        </div>
        <div class="ml-3 flex-1">
          <h1
            class="text-lg font-bold leading-tight tracking-tight text-slate-900 dark:text-white"
          >
            Transaction Analytics
          </h1>
          <p class="text-xs text-slate-500">Indian Cobbler Community Admin</p>
        </div>
        <button
          class="flex size-10 items-center justify-center rounded-full hover:bg-primary/10 transition-colors"
        >
          <span class="material-symbols-outlined">notifications</span>
        </button>
      </header>
      <!-- Stats Overview -->
      <div class="grid grid-cols-2 gap-4 p-4">
        <div
          class="flex flex-col gap-2 rounded-xl p-5 bg-white dark:bg-slate-800 shadow-sm border border-primary/5"
        >
          <div class="flex items-center gap-2 text-primary">
            <span class="material-symbols-outlined text-sm"
              >volunteer_activism</span
            >
            <p class="text-sm font-medium">Total Donations</p>
          </div>
          <p class="text-2xl font-bold">₹8,45,200</p>
          <div
            class="flex items-center gap-1 text-emerald-600 text-xs font-semibold"
          >
            <span class="material-symbols-outlined text-xs">trending_up</span>
            <span>+14.2%</span>
          </div>
        </div>
        <div
          class="flex flex-col gap-2 rounded-xl p-5 bg-white dark:bg-slate-800 shadow-sm border border-primary/5"
        >
          <div class="flex items-center gap-2 text-primary">
            <span class="material-symbols-outlined text-sm">favorite</span>
            <p class="text-sm font-medium">Matrimony Revenue</p>
          </div>
          <p class="text-2xl font-bold">₹2,12,500</p>
          <div
            class="flex items-center gap-1 text-emerald-600 text-xs font-semibold"
          >
            <span class="material-symbols-outlined text-xs">trending_up</span>
            <span>+8.4%</span>
          </div>
        </div>
      </div>
      <!-- Revenue Chart Section -->
      <div class="px-4 py-2">
        <div
          class="rounded-xl bg-white dark:bg-slate-800 p-5 shadow-sm border border-primary/5"
        >
          <div class="flex items-center justify-between mb-6">
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">
                Revenue Trends
              </h3>
              <p class="text-xs text-slate-500">
                Monthly breakdown of all collections
              </p>
            </div>
            <select
              class="text-xs bg-background-light dark:bg-slate-700 border-none rounded-lg focus:ring-primary"
            >
              <option>Last 6 Months</option>
              <option>Yearly</option>
            </select>
          </div>
          <div class="h-40 w-full">
            <svg
              class="w-full h-full"
              fill="none"
              preserveaspectratio="none"
              viewbox="0 0 400 150"
            >
              <path
                d="M0 120 Q 50 110, 100 80 T 200 60 T 300 30 T 400 10"
                fill="none"
                stroke="#f2780d"
                stroke-linecap="round"
                stroke-width="3"
              ></path>
              <path
                d="M0 120 Q 50 110, 100 80 T 200 60 T 300 30 T 400 10 V 150 H 0 Z"
                fill="url(#grad1)"
                opacity="0.1"
              ></path>
              <defs>
                <lineargradient id="grad1" x1="0%" x2="0%" y1="0%" y2="100%">
                  <stop
                    offset="0%"
                    style="stop-color: #f2780d; stop-opacity: 1"
                  ></stop>
                  <stop
                    offset="100%"
                    style="stop-color: #f2780d; stop-opacity: 0"
                  ></stop>
                </lineargradient>
              </defs>
            </svg>
          </div>
          <div
            class="flex justify-between mt-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest"
          >
            <span>Jan</span>
            <span>Feb</span>
            <span>Mar</span>
            <span>Apr</span>
            <span>May</span>
            <span>Jun</span>
          </div>
        </div>
      </div>
      <!-- Geographic Analytics -->
      <div class="p-4">
        <div
          class="rounded-xl bg-white dark:bg-slate-800 p-5 shadow-sm border border-primary/5"
        >
          <h3 class="font-bold text-slate-900 dark:text-white mb-4">
            Top Donation Pincodes
          </h3>
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div class="flex-1">
                <div class="flex justify-between text-xs mb-1">
                  <span class="font-medium">400001 (Mumbai South)</span>
                  <span class="text-primary font-bold">₹1.2L</span>
                </div>
                <div
                  class="w-full bg-slate-100 dark:bg-slate-700 h-1.5 rounded-full overflow-hidden"
                >
                  <div
                    class="bg-primary h-full rounded-full"
                    style="width: 85%"
                  ></div>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="flex-1">
                <div class="flex justify-between text-xs mb-1">
                  <span class="font-medium">110001 (Connaught Place)</span>
                  <span class="text-primary font-bold">₹85K</span>
                </div>
                <div
                  class="w-full bg-slate-100 dark:bg-slate-700 h-1.5 rounded-full overflow-hidden"
                >
                  <div
                    class="bg-primary h-full rounded-full"
                    style="width: 65%"
                  ></div>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="flex-1">
                <div class="flex justify-between text-xs mb-1">
                  <span class="font-medium">560001 (Bangalore Central)</span>
                  <span class="text-primary font-bold">₹72K</span>
                </div>
                <div
                  class="w-full bg-slate-100 dark:bg-slate-700 h-1.5 rounded-full overflow-hidden"
                >
                  <div
                    class="bg-primary h-full rounded-full"
                    style="width: 55%"
                  ></div>
                </div>
              </div>
            </div>
          </div>
          <button
            class="mt-4 w-full text-xs font-bold text-primary py-2 border border-primary/20 rounded-lg hover:bg-primary/5"
          >
            VIEW FULL HEATMAP
          </button>
        </div>
      </div>
      <!-- Recent Transactions -->
      <div class="px-4 mb-4">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-bold text-slate-900 dark:text-white">
            Recent Transactions
          </h3>
          <a class="text-xs font-bold text-primary uppercase" href="#"
            >View All</a
          >
        </div>
        <div class="space-y-3">
          <!-- Transaction Item -->
          <div
            class="flex items-center justify-between p-3 bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-primary/5"
          >
            <div class="flex items-center gap-3">
              <div
                class="size-10 rounded-full bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center text-primary"
              >
                <span class="material-symbols-outlined">person</span>
              </div>
              <div>
                <p class="text-sm font-bold">Rajesh Kumar</p>
                <p class="text-[10px] text-slate-500">
                  Matrimony Subscription • 10:45 AM
                </p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-sm font-bold text-slate-900 dark:text-white">
                ₹1,100
              </p>
              <span
                class="text-[10px] px-2 py-0.5 bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 rounded-full font-bold"
                >SUCCESS</span
              >
            </div>
          </div>
          <!-- Transaction Item -->
          <div
            class="flex items-center justify-between p-3 bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-primary/5"
          >
            <div class="flex items-center gap-3">
              <div
                class="size-10 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600"
              >
                <span class="material-symbols-outlined"
                  >volunteer_activism</span
                >
              </div>
              <div>
                <p class="text-sm font-bold">Anonymous Donor</p>
                <p class="text-[10px] text-slate-500">
                  Education Fund • 09:20 AM
                </p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-sm font-bold text-slate-900 dark:text-white">
                ₹5,000
              </p>
              <span
                class="text-[10px] px-2 py-0.5 bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 rounded-full font-bold"
                >SUCCESS</span
              >
            </div>
          </div>
          <!-- Transaction Item -->
          <div
            class="flex items-center justify-between p-3 bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-primary/5"
          >
            <div class="flex items-center gap-3">
              <div
                class="size-10 rounded-full bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center text-primary"
              >
                <span class="material-symbols-outlined">person</span>
              </div>
              <div>
                <p class="text-sm font-bold">Sunita Verma</p>
                <p class="text-[10px] text-slate-500">
                  Matrimony Subscription • Yesterday
                </p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-sm font-bold text-slate-900 dark:text-white">
                ₹1,100
              </p>
              <span
                class="text-[10px] px-2 py-0.5 bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 rounded-full font-bold"
                >PENDING</span
              >
            </div>
          </div>
        </div>
      </div>
      <!-- Bottom Navigation Bar -->
      <nav
        class="fixed bottom-0 left-0 right-0 border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-4 pb-6 pt-3 flex justify-between items-center z-50"
      >
        <a
          class="flex flex-col items-center gap-1 text-slate-400 hover:text-primary transition-colors"
          href="#"
        >
          <span class="material-symbols-outlined">dashboard</span>
          <span class="text-[10px] font-bold uppercase tracking-wider"
            >Home</span
          >
        </a>
        <a class="flex flex-col items-center gap-1 text-primary" href="#">
          <span class="material-symbols-outlined fill-1">receipt_long</span>
          <span class="text-[10px] font-bold uppercase tracking-wider"
            >Txns</span
          >
        </a>
        <div class="relative -top-8">
          <button
            class="size-14 bg-primary text-white rounded-full shadow-lg shadow-primary/30 flex items-center justify-center border-4 border-background-light dark:border-background-dark"
          >
            <span class="material-symbols-outlined text-3xl">add</span>
          </button>
        </div>
        <a
          class="flex flex-col items-center gap-1 text-slate-400 hover:text-primary transition-colors"
          href="#"
        >
          <span class="material-symbols-outlined">group</span>
          <span class="text-[10px] font-bold uppercase tracking-wider"
            >Members</span
          >
        </a>
        <a
          class="flex flex-col items-center gap-1 text-slate-400 hover:text-primary transition-colors"
          href="#"
        >
          <span class="material-symbols-outlined">settings</span>
          <span class="text-[10px] font-bold uppercase tracking-wider"
            >Setup</span
          >
        </a>
      </nav>
    </div>
  </body>
</html>
