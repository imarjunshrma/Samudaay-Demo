    <style>
      .material-symbols-outlined {
        font-variation-settings:
          "FILL" 0,
          "wght" 400,
          "GRAD" 0,
          "opsz" 24;
        vertical-align: middle;
      }
      body {
        font-family: "Manrope", sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      h1,
      h2,
      h3,
      .font-serif {
        font-family: "Newsreader", serif;
      }
      .hide-scrollbar::-webkit-scrollbar {
        display: none;
      }
    </style>
    <style>
      body {
        min-height: max(884px, 100dvh);
      }
    </style>
  </head>
  <body class="bg-surface text-on-surface min-h-screen pb-24 md:pb-0">
    <!-- TopAppBar -->
    <header
      class="fixed top-0 w-full z-50 bg-stone-50/80 dark:bg-stone-900/80 backdrop-blur-md"
    >
      <div
        class="flex justify-between items-center px-6 py-4 w-full max-w-7xl mx-auto"
      >
        <div class="flex items-center gap-4">
          <button
            class="p-2 text-[#46291e] dark:text-[#d7ccc8] hover:bg-stone-200/50 dark:hover:bg-stone-800/50 transition-colors rounded-full active:scale-95 duration-150"
          >
            <span class="material-symbols-outlined" data-icon="grid_view"
              >grid_view</span
            >
          </button>
          <span
            class="text-2xl font-serif italic text-[#46291e] dark:text-[#d7ccc8]"
            >The Digital Atelier</span
          >
        </div>
        <nav class="hidden md:flex items-center gap-8">
          <a
            class="text-[#46291e]/60 dark:text-[#d7ccc8]/60 font-label uppercase text-[11px] tracking-widest hover:text-[#964900]"
            href="#"
            >Clients</a
          >
          <a
            class="text-[#964900] dark:text-[#ffb74d] font-bold font-label uppercase text-[11px] tracking-widest"
            href="#"
            >Configs</a
          >
          <a
            class="text-[#46291e]/60 dark:text-[#d7ccc8]/60 font-label uppercase text-[11px] tracking-widest hover:text-[#964900]"
            href="#"
            >Billing</a
          >
          <a
            class="text-[#46291e]/60 dark:text-[#d7ccc8]/60 font-label uppercase text-[11px] tracking-widest hover:text-[#964900]"
            href="#"
            >Audit</a
          >
        </nav>
        <div class="flex items-center gap-3">
          <span class="hidden md:block text-right">
            <p
              class="text-[10px] uppercase tracking-tighter text-outline opacity-70"
            >
              Superadmin
            </p>
            <p class="text-xs font-bold text-primary">Master Artisan</p>
          </span>
          <div
            class="w-10 h-10 rounded-full bg-surface-container-highest border border-outline-variant/20 flex items-center justify-center overflow-hidden"
          >
            <img
              alt="Superadmin Profile"
              data-alt="professional portrait of an elderly artisan workshop manager with spectacles and a kind expression"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDUVouIvUhXogPvl35Bg0hXvbYrK8onW5ZJ-ToDaZN072aSrj07fJoPFE-bpvPDC6vD9I_uhMCJ0ocWXefjoKMwY74r5XAWY9FVmksJpISqWEq1jsRsRsd9VKkMwFVLMV7gK40XUHMiEqVQdV-7kEuPQwWi4oMiNR_BDB7Z2p0tA9vV-AtJGwrb4oGOmip_NXx1WU8U0TZ61JsMj1q99fLa0dCl5A6ajqVgjvsOafYgWw9j5Qt1dsZi1cmlJvhbQCp1-JYScSHK7avW"
            />
          </div>
        </div>
      </div>
    </header>
    <main class="pt-24 pb-12 px-6 max-w-7xl mx-auto">
      <!-- Breadcrumbs & Header -->
      <section class="mb-12">
        <div class="flex items-center gap-2 text-outline text-sm mb-4">
          <span>Clients</span>
          <span
            class="material-symbols-outlined text-xs"
            data-icon="chevron_right"
            >chevron_right</span
          >
          <span>Aurum Leatherworks</span>
          <span
            class="material-symbols-outlined text-xs"
            data-icon="chevron_right"
            >chevron_right</span
          >
          <span class="text-primary font-medium">Configuration</span>
        </div>
        <div
          class="flex flex-col md:flex-row md:items-end justify-between gap-6"
        >
          <div>
            <h1
              class="text-5xl md:text-6xl font-headline italic tracking-tight text-primary"
            >
              Aurum Leatherworks
            </h1>
            <p class="text-on-surface-variant mt-2 max-w-xl">
              Bespoke workshop profile and environmental parameters for
              high-fidelity digital production.
            </p>
          </div>
          <div class="flex gap-4">
            <button
              class="px-8 py-3 bg-surface-container-high text-primary font-bold rounded-lg hover:bg-stone-200 transition-colors active:scale-95"
            >
              Discard
            </button>
            <button
              class="px-8 py-3 bg-primary text-on-primary font-bold rounded-lg shadow-xl shadow-primary/10 hover:bg-primary-container transition-colors active:scale-95"
            >
              Save Changes
            </button>
          </div>
        </div>
      </section>
      <!-- Configuration Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Core Settings: Left Column -->
        <div class="lg:col-span-7 space-y-8">
          <!-- Licensing Section -->
          <section class="bg-surface-container-low p-8 rounded-xl space-y-8">
            <div class="flex items-center gap-3 mb-2">
              <span
                class="material-symbols-outlined text-secondary"
                data-icon="verified_user"
                >verified_user</span
              >
              <h2 class="text-xl font-headline font-bold text-primary">
                License &amp; Access
              </h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <!-- License Type -->
              <div class="space-y-2">
                <label
                  class="block text-[11px] uppercase tracking-widest text-outline font-bold"
                  >License Type</label
                >
                <div class="relative">
                  <select
                    class="w-full bg-surface-container-lowest border-0 border-b border-outline-variant/30 py-4 px-0 focus:ring-0 focus:border-primary appearance-none text-primary font-medium"
                  >
                    <option>Artisan Studio (Pro)</option>
                    <option>Individual Craftsman</option>
                    <option>Global Manufacturing Enterprise</option>
                  </select>
                  <span
                    class="material-symbols-outlined absolute right-0 top-4 pointer-events-none text-outline"
                    data-icon="expand_more"
                    >expand_more</span
                  >
                </div>
              </div>
              <!-- Max Users -->
              <div class="space-y-2">
                <label
                  class="block text-[11px] uppercase tracking-widest text-outline font-bold"
                  >Max User Count</label
                >
                <div class="flex items-center gap-4">
                  <input
                    class="w-full bg-surface-container-lowest border-0 border-b border-outline-variant/30 py-4 px-0 focus:ring-0 focus:border-primary text-primary font-medium"
                    type="number"
                    value="24"
                  />
                  <span
                    class="px-3 py-1 bg-tertiary-container/10 text-tertiary text-[10px] font-bold uppercase rounded-full"
                    >Seats Left: 4</span
                  >
                </div>
              </div>
            </div>
            <!-- Toggle: Sub-communities -->
            <div
              class="flex items-center justify-between p-6 bg-surface-container rounded-lg border border-outline-variant/10"
            >
              <div class="space-y-1">
                <h3 class="font-bold text-primary">Allow Sub-communities</h3>
                <p class="text-sm text-on-surface-variant max-w-xs">
                  Enable creation of nested guild-style departments within this
                  client's workspace.
                </p>
              </div>
              <button
                aria-checked="true"
                class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none bg-primary"
                role="switch"
              >
                <span
                  aria-hidden="true"
                  class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out translate-x-5"
                ></span>
              </button>
            </div>
          </section>
          <!-- Branding Section -->
          <section class="bg-surface-container-low p-8 rounded-xl space-y-8">
            <div class="flex items-center gap-3 mb-2">
              <span
                class="material-symbols-outlined text-secondary"
                data-icon="palette"
                >palette</span
              >
              <h2 class="text-xl font-headline font-bold text-primary">
                The Visual Identity
              </h2>
            </div>
            <!-- Logo Upload -->
            <div class="space-y-4">
              <label
                class="block text-[11px] uppercase tracking-widest text-outline font-bold"
                >Client Brand Logo</label
              >
              <div class="flex flex-col md:flex-row items-center gap-8">
                <div
                  class="w-32 h-32 rounded-xl bg-surface-container-lowest border border-dashed border-outline-variant flex items-center justify-center overflow-hidden group relative"
                >
                  <img
                    alt="Client Logo"
                    class="w-24 h-24 object-contain opacity-80"
                    data-alt="minimalist golden hawk emblem logo on a cream background"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuAO85Fs909FEiy6RJ9URS6UUI50Io1t9AdQBEQkoz-iK-wCND-XbcvYMjhfqAdaB8_nTTnJ7zkSXbZIeL5OnoxmSCQfGLdj39wYacGtfbaeMuJEG0i6X09In4xaeiq7zeewdByJSGpMTVqv7rtk7tCza1W9E7n09hk2Ss-vz8tPIZFEK38p66j0sMKAkZcSdfwhZAt0pkektWzDzEMs4R7gkObw1SzRqIGF_qIxOpuASoHNJakCfMl2qW92vxw0p08wyPAeePOmD3YU"
                  />
                  <div
                    class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center cursor-pointer"
                  >
                    <span
                      class="material-symbols-outlined text-white"
                      data-icon="upload"
                      >upload</span
                    >
                  </div>
                </div>
                <div class="space-y-2 flex-1">
                  <p class="text-sm text-primary font-bold">
                    aurum_master_v2.svg
                  </p>
                  <p class="text-xs text-on-surface-variant">
                    Recommended: 512x512px SVG or PNG with transparent
                    background. Max 2MB.
                  </p>
                  <button
                    class="text-xs text-secondary font-bold flex items-center gap-1 hover:underline"
                  >
                    <span
                      class="material-symbols-outlined text-sm"
                      data-icon="delete"
                      >delete</span
                    >
                    Remove Logo
                  </button>
                </div>
              </div>
            </div>
            <!-- Theme Selector -->
            <div class="space-y-6">
              <label
                class="block text-[11px] uppercase tracking-widest text-outline font-bold"
                >Signature Color Palette</label
              >
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <!-- Palette Option 1 (Active) -->
                <button
                  class="p-4 rounded-xl border-2 border-primary bg-surface-container-lowest text-left transition-all ring-4 ring-primary/5"
                >
                  <div class="flex gap-1 mb-3">
                    <div class="w-6 h-6 rounded-full bg-[#46291e]"></div>
                    <div class="w-6 h-6 rounded-full bg-[#964900]"></div>
                    <div
                      class="w-6 h-6 rounded-full bg-[#fdf9f6] border border-stone-200"
                    ></div>
                  </div>
                  <span class="text-xs font-bold text-primary"
                    >Bespoke Tan</span
                  >
                </button>
                <!-- Palette Option 2 -->
                <button
                  class="p-4 rounded-xl border border-outline-variant/30 bg-surface-container-lowest text-left hover:border-outline transition-all"
                >
                  <div class="flex gap-1 mb-3">
                    <div class="w-6 h-6 rounded-full bg-[#1a2e35]"></div>
                    <div class="w-6 h-6 rounded-full bg-[#5d6d7e]"></div>
                    <div
                      class="w-6 h-6 rounded-full bg-[#f8f9f9] border border-stone-200"
                    ></div>
                  </div>
                  <span class="text-xs font-bold text-on-surface-variant"
                    >Slate &amp; Steel</span
                  >
                </button>
                <!-- Palette Option 3 -->
                <button
                  class="p-4 rounded-xl border border-outline-variant/30 bg-surface-container-lowest text-left hover:border-outline transition-all"
                >
                  <div class="flex gap-1 mb-3">
                    <div class="w-6 h-6 rounded-full bg-[#2d5a27]"></div>
                    <div class="w-6 h-6 rounded-full bg-[#8fb9a8]"></div>
                    <div
                      class="w-6 h-6 rounded-full bg-[#f4f7f4] border border-stone-200"
                    ></div>
                  </div>
                  <span class="text-xs font-bold text-on-surface-variant"
                    >Forest Path</span
                  >
                </button>
                <!-- Custom -->
                <button
                  class="p-4 rounded-xl border border-outline-variant/30 border-dashed bg-surface-container-lowest flex flex-col items-center justify-center gap-1 hover:bg-stone-50 transition-all"
                >
                  <span
                    class="material-symbols-outlined text-outline"
                    data-icon="add_circle"
                    >add_circle</span
                  >
                  <span class="text-xs font-bold text-outline">Custom Hex</span>
                </button>
              </div>
            </div>
          </section>
        </div>
        <!-- Contextual Information: Right Column -->
        <aside class="lg:col-span-5 space-y-8">
          <!-- Status Card -->
          <div
            class="bg-primary text-on-primary p-8 rounded-xl shadow-2xl shadow-primary/20 relative overflow-hidden"
          >
            <div
              class="absolute -top-12 -right-12 w-48 h-48 bg-white/5 rounded-full blur-3xl"
            ></div>
            <div class="relative z-10">
              <div class="flex items-center gap-2 mb-6">
                <span
                  class="px-3 py-1 bg-white/20 rounded-full text-[10px] font-bold uppercase tracking-widest backdrop-blur-sm"
                  >Active Subscription</span
                >
              </div>
              <h3 class="text-3xl font-headline italic mb-4">
                Enterprise Tallow
              </h3>
              <div class="space-y-4">
                <div
                  class="flex justify-between text-sm border-b border-white/10 pb-2"
                >
                  <span class="opacity-60">Created</span>
                  <span class="font-medium">Jan 12, 2024</span>
                </div>
                <div
                  class="flex justify-between text-sm border-b border-white/10 pb-2"
                >
                  <span class="opacity-60">Last Configured</span>
                  <span class="font-medium">2 hours ago</span>
                </div>
                <div class="flex justify-between text-sm">
                  <span class="opacity-60">Managed By</span>
                  <span class="font-medium underline decoration-white/20"
                    >Julian Vane</span
                  >
                </div>
              </div>
            </div>
          </div>
          <!-- Preview Card -->
          <div
            class="bg-surface-container border border-outline-variant/20 rounded-xl p-8 space-y-6"
          >
            <h3
              class="text-[11px] uppercase tracking-widest text-outline font-bold"
            >
              Real-time Interface Preview
            </h3>
            <div
              class="aspect-video bg-white rounded-lg shadow-sm border border-outline-variant/10 overflow-hidden flex flex-col"
            >
              <div class="h-4 bg-primary w-full"></div>
              <div class="flex-1 p-4 space-y-3">
                <div class="flex items-center gap-3">
                  <div
                    class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center"
                  >
                    <div class="w-4 h-4 rounded-sm bg-secondary"></div>
                  </div>
                  <div class="space-y-1">
                    <div class="h-2 w-24 bg-stone-200 rounded"></div>
                    <div class="h-1.5 w-16 bg-stone-100 rounded"></div>
                  </div>
                </div>
                <div
                  class="h-24 bg-stone-50 rounded-lg flex items-center justify-center"
                >
                  <span class="text-[10px] text-outline italic"
                    >Dashboard Content Placeholder</span
                  >
                </div>
              </div>
            </div>
            <p class="text-xs text-on-surface-variant italic leading-relaxed">
              Changes to the palette and logo will propagate across the client's
              workspace instantly upon saving.
            </p>
          </div>
          <!-- Support/Audit Quick Link -->
          <div
            class="flex items-center gap-4 p-6 bg-tertiary-container/5 rounded-xl border border-tertiary/10"
          >
            <div
              class="w-10 h-10 rounded-full bg-tertiary text-white flex items-center justify-center"
            >
              <span
                class="material-symbols-outlined text-lg"
                data-icon="history"
                >history</span
              >
            </div>
            <div>
              <h4 class="text-sm font-bold text-tertiary">Audit Trail</h4>
              <p class="text-xs text-on-surface-variant">
                View all historical configuration changes for this client.
              </p>
            </div>
            <span
              class="material-symbols-outlined ml-auto text-tertiary/40"
              data-icon="arrow_forward"
              >arrow_forward</span
            >
          </div>
        </aside>
      </div>
    </main>
    <!-- BottomNavBar (Mobile Only) -->
    <nav
      class="md:hidden fixed bottom-0 left-0 w-full flex justify-around items-center px-4 pb-4 pt-2 bg-stone-100 dark:bg-stone-950 border-t border-stone-200/30 dark:border-stone-800/30 shadow-[0_-4px_24px_rgba(70,41,30,0.06)] z-50"
    >
      <a
        class="flex flex-col items-center justify-center text-[#46291e]/50 dark:text-[#d7ccc8]/40 px-4 py-1.5 hover:text-[#964900] transition-transform active:translate-y-0.5"
        href="#"
      >
        <span class="material-symbols-outlined" data-icon="corporate_fare"
          >corporate_fare</span
        >
        <span class="text-[11px] font-sans tracking-wide uppercase mt-1"
          >Clients</span
        >
      </a>
      <a
        class="flex flex-col items-center justify-center bg-[#603f33] text-stone-50 rounded-lg px-4 py-1.5 transition-transform active:translate-y-0.5"
        href="#"
      >
        <span
          class="material-symbols-outlined"
          data-icon="settings_input_component"
          >settings_input_component</span
        >
        <span class="text-[11px] font-sans tracking-wide uppercase mt-1"
          >Configs</span
        >
      </a>
      <a
        class="flex flex-col items-center justify-center text-[#46291e]/50 dark:text-[#d7ccc8]/40 px-4 py-1.5 hover:text-[#964900] transition-transform active:translate-y-0.5"
        href="#"
      >
        <span class="material-symbols-outlined" data-icon="payments"
          >payments</span
        >
        <span class="text-[11px] font-sans tracking-wide uppercase mt-1"
          >Billing</span
        >
      </a>
      <a
        class="flex flex-col items-center justify-center text-[#46291e]/50 dark:text-[#d7ccc8]/40 px-4 py-1.5 hover:text-[#964900] transition-transform active:translate-y-0.5"
        href="#"
      >
        <span class="material-symbols-outlined" data-icon="receipt_long"
          >receipt_long</span
        >
        <span class="text-[11px] font-sans tracking-wide uppercase mt-1"
          >Audit</span
        >
      </a>
    </nav>
  </body>
</html>
