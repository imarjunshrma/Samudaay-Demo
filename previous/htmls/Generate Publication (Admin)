<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#f2780d",
              "background-light": "#f8f7f5",
              "background-dark": "#221810",
            },
            fontFamily: {
              display: ["Public Sans"],
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              full: "9999px",
            },
          },
        },
      };
    </script>
    <title>Generate Monthly Publication</title>
    <style>
      body {
        min-height: max(884px, 100dvh);
      }
    </style>
  </head>
  <body
    class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 min-h-screen"
  >
    <div class="max-w-2xl mx-auto pb-24">
      <!-- Header -->
      <div
        class="flex items-center bg-background-light dark:bg-background-dark p-4 sticky top-0 z-10 border-b border-primary/10"
      >
        <div
          class="text-primary flex size-10 shrink-0 items-center justify-center rounded-full hover:bg-primary/10 cursor-pointer"
        >
          <span class="material-symbols-outlined">arrow_back</span>
        </div>
        <h2
          class="text-slate-900 dark:text-white text-xl font-bold leading-tight tracking-tight flex-1 ml-2"
        >
          Generate Monthly Publication
        </h2>
      </div>
      <div class="p-4 space-y-8">
        <!-- Date Selection -->
        <section>
          <h3
            class="text-slate-900 dark:text-white text-lg font-bold leading-tight mb-4"
          >
            Select Publication Month
          </h3>
          <div class="flex flex-wrap items-end gap-4">
            <label class="flex flex-col min-w-full sm:min-w-[240px] flex-1">
              <p
                class="text-slate-700 dark:text-slate-300 text-sm font-medium pb-2"
              >
                Month and Year
              </p>
              <div class="relative">
                <select
                  class="appearance-none w-full rounded-lg text-slate-900 dark:text-white focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-primary/20 bg-white dark:bg-background-dark h-14 px-4 text-base font-normal leading-normal"
                >
                  <option value="jan-2024">January 2024</option>
                  <option value="feb-2024">February 2024</option>
                  <option value="mar-2024">March 2024</option>
                  <option value="apr-2024">April 2024</option>
                </select>
                <span
                  class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-primary"
                  >calendar_month</span
                >
              </div>
            </label>
          </div>
        </section>
        <!-- Content Selection -->
        <section>
          <h3
            class="text-slate-900 dark:text-white text-lg font-bold leading-tight mb-4"
          >
            Content to Include
          </h3>
          <div class="grid grid-cols-1 gap-3">
            <label
              class="flex items-center gap-3 p-4 rounded-xl border border-primary/10 bg-white dark:bg-white/5 cursor-pointer hover:border-primary/40 transition-colors"
            >
              <input
                checked=""
                class="size-5 rounded border-primary/30 text-primary focus:ring-primary"
                type="checkbox"
              />
              <span class="text-slate-800 dark:text-slate-200 font-medium"
                >Community News Articles</span
              >
            </label>
            <label
              class="flex items-center gap-3 p-4 rounded-xl border border-primary/10 bg-white dark:bg-white/5 cursor-pointer hover:border-primary/40 transition-colors"
            >
              <input
                checked=""
                class="size-5 rounded border-primary/30 text-primary focus:ring-primary"
                type="checkbox"
              />
              <span class="text-slate-800 dark:text-slate-200 font-medium"
                >Active Advertisements</span
              >
            </label>
            <label
              class="flex items-center gap-3 p-4 rounded-xl border border-primary/10 bg-white dark:bg-white/5 cursor-pointer hover:border-primary/40 transition-colors"
            >
              <input
                class="size-5 rounded border-primary/30 text-primary focus:ring-primary"
                type="checkbox"
              />
              <span class="text-slate-800 dark:text-slate-200 font-medium"
                >Featured Matrimony Profiles</span
              >
            </label>
            <label
              class="flex items-center gap-3 p-4 rounded-xl border border-primary/10 bg-white dark:bg-white/5 cursor-pointer hover:border-primary/40 transition-colors"
            >
              <input
                checked=""
                class="size-5 rounded border-primary/30 text-primary focus:ring-primary"
                type="checkbox"
              />
              <span class="text-slate-800 dark:text-slate-200 font-medium"
                >Recent Event Highlights</span
              >
            </label>
          </div>
        </section>
        <!-- Action Button -->
        <button
          class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 rounded-xl shadow-lg shadow-primary/20 flex items-center justify-center gap-2 transition-transform active:scale-[0.98]"
        >
          <span class="material-symbols-outlined">picture_as_pdf</span>
          Generate &amp; Preview PDF
        </button>
        <!-- Recently Generated PDFs -->
        <section class="pt-4">
          <div class="flex items-center justify-between mb-4">
            <h3
              class="text-slate-900 dark:text-white text-lg font-bold leading-tight"
            >
              Recently Generated PDFs
            </h3>
            <button class="text-primary text-sm font-semibold hover:underline">
              View All
            </button>
          </div>
          <div class="space-y-3">
            <!-- Item 1 -->
            <div
              class="flex items-center justify-between p-4 bg-white dark:bg-white/5 rounded-xl border border-primary/5"
            >
              <div class="flex items-center gap-3">
                <div
                  class="size-10 bg-primary/10 text-primary rounded-lg flex items-center justify-center"
                >
                  <span class="material-symbols-outlined">description</span>
                </div>
                <div>
                  <p class="font-bold text-slate-900 dark:text-white text-sm">
                    December 2023 Edition
                  </p>
                  <p class="text-xs text-slate-500">
                    Generated on Dec 28, 2023
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <span
                  class="px-2 py-1 bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400 text-[10px] font-bold uppercase rounded tracking-wider"
                  >Ready</span
                >
                <a class="text-primary hover:text-primary/80" href="#">
                  <span class="material-symbols-outlined">download</span>
                </a>
              </div>
            </div>
            <!-- Item 2 -->
            <div
              class="flex items-center justify-between p-4 bg-white dark:bg-white/5 rounded-xl border border-primary/5"
            >
              <div class="flex items-center gap-3">
                <div
                  class="size-10 bg-primary/10 text-primary rounded-lg flex items-center justify-center"
                >
                  <span class="material-symbols-outlined">description</span>
                </div>
                <div>
                  <p class="font-bold text-slate-900 dark:text-white text-sm">
                    January 2024 Draft
                  </p>
                  <p class="text-xs text-slate-500">Started 5 mins ago</p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <span
                  class="px-2 py-1 bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 text-[10px] font-bold uppercase rounded tracking-wider"
                  >In Progress</span
                >
                <span
                  class="material-symbols-outlined text-slate-300 dark:text-slate-700"
                  >download</span
                >
              </div>
            </div>
            <!-- Item 3 -->
            <div
              class="flex items-center justify-between p-4 bg-white dark:bg-white/5 rounded-xl border border-primary/5"
            >
              <div class="flex items-center gap-3">
                <div
                  class="size-10 bg-primary/10 text-primary rounded-lg flex items-center justify-center"
                >
                  <span class="material-symbols-outlined">description</span>
                </div>
                <div>
                  <p class="font-bold text-slate-900 dark:text-white text-sm">
                    November 2023 Final
                  </p>
                  <p class="text-xs text-slate-500">
                    Generated on Nov 25, 2023
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <span
                  class="px-2 py-1 bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400 text-[10px] font-bold uppercase rounded tracking-wider"
                  >Ready</span
                >
                <a class="text-primary hover:text-primary/80" href="#">
                  <span class="material-symbols-outlined">download</span>
                </a>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
    <!-- Bottom Navigation -->
    <div
      class="fixed bottom-0 left-0 right-0 border-t border-primary/10 bg-white/80 dark:bg-background-dark/80 backdrop-blur-md px-4 pb-4 pt-2 flex justify-around items-center z-50"
    >
      <a
        class="flex flex-col items-center gap-1 text-slate-500 dark:text-slate-400"
        href="#"
      >
        <span class="material-symbols-outlined">dashboard</span>
        <p class="text-[10px] font-bold uppercase tracking-wider">Dashboard</p>
      </a>
      <a class="flex flex-col items-center gap-1 text-primary" href="#">
        <span
          class="material-symbols-outlined"
          style="font-variation-settings: &quot;FILL&quot; 1"
          >file_open</span
        >
        <p class="text-[10px] font-bold uppercase tracking-wider">Generate</p>
      </a>
      <a
        class="flex flex-col items-center gap-1 text-slate-500 dark:text-slate-400"
        href="#"
      >
        <span class="material-symbols-outlined">settings</span>
        <p class="text-[10px] font-bold uppercase tracking-wider">Settings</p>
      </a>
    </div>
  </body>
</html>
