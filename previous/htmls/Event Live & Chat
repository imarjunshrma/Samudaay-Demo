<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>National Meetup Delhi - Live</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#f2780d",
              "background-light": "#f8f7f5",
              "background-dark": "#221810",
            },
            fontFamily: {
              display: ["Public Sans"],
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              full: "9999px",
            },
          },
        },
      };
    </script>
    <style>
      body {
        min-height: max(884px, 100dvh);
      }
    </style>
  </head>
  <body
    class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100"
  >
    <div
      class="relative flex h-screen w-full flex-col overflow-hidden max-w-md mx-auto border-x border-primary/10 bg-background-light dark:bg-background-dark"
    >
      <!-- Header -->
      <header
        class="flex items-center px-4 py-3 justify-between border-b border-primary/10"
      >
        <div
          class="text-slate-900 dark:text-slate-100 flex size-10 shrink-0 items-center justify-center rounded-full hover:bg-primary/10 cursor-pointer"
        >
          <span class="material-symbols-outlined">arrow_back</span>
        </div>
        <h2
          class="text-slate-900 dark:text-slate-100 text-lg font-bold leading-tight tracking-tight flex-1 text-center px-2 truncate"
        >
          National Meetup Delhi - Live
        </h2>
        <div
          class="flex size-10 items-center justify-center rounded-full hover:bg-primary/10 cursor-pointer"
        >
          <span class="material-symbols-outlined">share</span>
        </div>
      </header>
      <!-- Video Player Section -->
      <div class="bg-slate-900 w-full aspect-video relative group">
        <div
          class="absolute inset-0 bg-cover bg-center opacity-80"
          data-alt="A professional live stream of a community workshop event"
          style="
            background-image: url(&quot;https://lh3.googleusercontent.com/aida-public/AB6AXuA-sE38YZKkGnLB0ndUFqGdVzJaQV9PpQ7hdz0-dZeth4lsY9lAmo0n2sY75owSimLgXrEFNRCY1oaNcG8u6QSp42j_wTEAQJYq1jQYLylGCdNZH15anEfDS2ZVaKkge3kWbdOlu17y8xyJpfHX_K3x89W0aX1VNyvvv9nYM_CWG5E4DhbUf-87woKJBfpJQogz6awieP7s1xbpf45V39LgL9feU70j9iIcQZEwchoRr5wnOzKG0Dap9dUjd2DN3SLTRAA1d0EPuSIy&quot;);
          "
        ></div>
        <!-- Video Overlays -->
        <div class="absolute top-4 left-4 flex items-center gap-2">
          <div
            class="bg-red-600 text-white text-[10px] font-bold px-2 py-0.5 rounded flex items-center gap-1"
          >
            <span class="size-1.5 bg-white rounded-full animate-pulse"></span>
            LIVE
          </div>
          <div
            class="bg-black/60 text-white text-[10px] font-medium px-2 py-0.5 rounded flex items-center gap-1 backdrop-blur-sm"
          >
            <span class="material-symbols-outlined text-xs">visibility</span>
            1.2k
          </div>
        </div>
        <button
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center rounded-full size-16 bg-primary text-white shadow-xl hover:scale-105 transition-transform"
        >
          <span class="material-symbols-outlined text-4xl fill-1"
            >play_arrow</span
          >
        </button>
        <!-- Video Controls -->
        <div
          class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-black/80 to-transparent"
        >
          <div
            class="flex h-1.5 items-center justify-center mb-2 group/progress cursor-pointer"
          >
            <div class="h-1 flex-1 rounded-full bg-primary"></div>
            <div
              class="size-3 rounded-full bg-primary border-2 border-white shadow"
            ></div>
            <div class="h-1 w-24 rounded-full bg-white/30"></div>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span
                class="material-symbols-outlined text-white text-xl cursor-pointer"
                >pause</span
              >
              <span
                class="material-symbols-outlined text-white text-xl cursor-pointer"
                >volume_up</span
              >
              <p class="text-white text-xs font-medium">12:45 / 45:00</p>
            </div>
            <span
              class="material-symbols-outlined text-white text-xl cursor-pointer"
              >fullscreen</span
            >
          </div>
        </div>
      </div>
      <!-- Chat Header -->
      <div
        class="flex items-center justify-between px-4 py-3 border-b border-primary/10 bg-primary/5"
      >
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-lg"
            >forum</span
          >
          <h4 class="text-primary text-sm font-bold uppercase tracking-wider">
            Live Chat
          </h4>
        </div>
        <span
          class="material-symbols-outlined text-slate-400 text-lg cursor-pointer"
          >settings</span
        >
      </div>
      <!-- Chat Messages -->
      <div
        class="flex-1 overflow-y-auto p-4 space-y-6 bg-background-light dark:bg-background-dark"
      >
        <!-- Message 1 -->
        <div class="flex items-start gap-3">
          <div
            class="size-9 rounded-full bg-primary/20 flex-shrink-0 border border-primary/10 overflow-hidden"
          >
            <img
              alt="Rajesh Kumar avatar"
              class="w-full h-full object-cover"
              data-alt="Portrait of a smiling Indian man"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuBzeBXPip04-BdoaU6fVGzd3U4dpHLC-BDLuMmnIXJt_vFc3cdOacseaUzAj63sblhouL9LrmcIRj51VJsQ6GTg5PelDm3zAreHMizfwftehimW3ZQIyipVwozgt8hPmnxpKM-TVFv39bl9qDra-gmBP32QoNfExwrSvvZcAAYVW5V-NSvz0UVFDNc0zDqw2Qpb1VggZlymmR1gXwMsqD0YNqKYSTd8oz50BuZRwG9eMVX405U_5hGet2LGHmhau9C3XjnOtiykxowB"
            />
          </div>
          <div class="flex flex-col gap-1.5 max-w-[85%]">
            <div class="flex items-center gap-2">
              <span class="text-primary font-bold text-xs">Rajesh Kumar</span>
              <span class="text-[10px] text-slate-400">14:02</span>
            </div>
            <div
              class="bg-white dark:bg-slate-800 rounded-tr-xl rounded-br-xl rounded-bl-xl px-3 py-2 shadow-sm border border-primary/5"
            >
              <p class="text-sm leading-relaxed">
                Namaste everyone! Great to see so many cobblers here from all
                over the country. This session is very informative.
              </p>
            </div>
          </div>
        </div>
        <!-- Message 2 -->
        <div class="flex items-start gap-3">
          <div
            class="size-9 rounded-full bg-primary/20 flex-shrink-0 border border-primary/10 overflow-hidden"
          >
            <img
              alt="Sunita Devi avatar"
              class="w-full h-full object-cover"
              data-alt="Portrait of a professional Indian woman"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuB0y_IUjHYoOjpfOev5k-2OJVA5UC7SE5pb0YY-9ZU7gpyDFGEJf1uHj2nwHlyiR3MNa9CSE0FTLjEnxHxDyFKog1uD6qFFF9lnsaJYvV1Vyn6rORS4DSMDy5oPly8xMjuygiTfsHV7xk8KFREBUAPPSoEemr6-M6uiJNi5a_RKGq_q8_7PAx0FhQtQUGqphvz0RB-gMW4OOUWLnBRgDDaIrxnB2gE0XQSC9f5p3TXKpZHKEOzeTQVsQ4oEEv3--utH_eC8J8hDJmZ6"
            />
          </div>
          <div class="flex flex-col gap-1.5 max-w-[85%]">
            <div class="flex items-center gap-2">
              <span class="text-primary font-bold text-xs">Sunita Devi</span>
              <span class="text-[10px] text-slate-400">14:05</span>
            </div>
            <div
              class="bg-white dark:bg-slate-800 rounded-tr-xl rounded-br-xl rounded-bl-xl px-3 py-2 shadow-sm border border-primary/5"
            >
              <p class="text-sm leading-relaxed">
                The new leather stitching technique shown is very helpful. Will
                this recording be available later? 🙏
              </p>
            </div>
          </div>
        </div>
        <!-- Message 3 (System/Info) -->
        <div class="flex justify-center py-2">
          <span
            class="text-[11px] font-medium text-slate-400 bg-slate-100 dark:bg-slate-800/50 px-3 py-1 rounded-full border border-primary/5"
          >
            Amit Sharma joined the stream
          </span>
        </div>
        <!-- Message 4 -->
        <div class="flex items-start gap-3">
          <div
            class="size-9 rounded-full bg-primary/20 flex-shrink-0 border border-primary/10 overflow-hidden"
          >
            <img
              alt="Amit Sharma avatar"
              class="w-full h-full object-cover"
              data-alt="Portrait of a young Indian craftsman"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDE3oCajN3fBxmY_q-QIFWJjN5lEPGfFkU2K4u20ieALyayGPdhWVjCsuS5JZip-fh58XI-WzCiyufGrHQx0q_-VL14BmOP74noeDSdtXc_jul-RnusAN0VMNbFzOVMm3HtvdNrLqOyVYCm5oHc-_XQD2t2jFnd4qgUsojRtppn55Gz6zvE_y2PS0-VNkBVn8HBXbq-zjwL8YJTwFFWks4tqzrlwIjXs3g8SiHfIrioDeExySz5JjeV2m7PUspq2FhLBZQL_j0JRQVL"
            />
          </div>
          <div class="flex flex-col gap-1.5 max-w-[85%]">
            <div class="flex items-center gap-2">
              <span class="text-primary font-bold text-xs">Amit Sharma</span>
              <span class="text-[10px] text-slate-400">14:08</span>
            </div>
            <div
              class="bg-white dark:bg-slate-800 rounded-tr-xl rounded-br-xl rounded-bl-xl px-3 py-2 shadow-sm border border-primary/5"
            >
              <p class="text-sm leading-relaxed">
                Hello everyone! Watching from Jaipur. Excited to learn about the
                new government schemes.
              </p>
            </div>
          </div>
        </div>
      </div>
      <!-- Chat Input -->
      <div class="p-4 border-t border-primary/10 bg-white dark:bg-slate-900/50">
        <div class="flex items-center gap-2">
          <div class="flex-1 relative">
            <input
              class="w-full pl-4 pr-10 py-2.5 bg-slate-50 dark:bg-slate-800 border-primary/10 rounded-full text-sm focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all"
              placeholder="Type your message..."
              type="text"
            />
            <div
              class="absolute right-3 top-1/2 -translate-y-1/2 flex items-center gap-1 text-slate-400"
            >
              <span
                class="material-symbols-outlined text-xl cursor-pointer hover:text-primary"
                >mood</span
              >
            </div>
          </div>
          <button
            class="size-11 rounded-full bg-primary text-white flex items-center justify-center shadow-lg shadow-primary/20 active:scale-95 transition-transform"
          >
            <span class="material-symbols-outlined fill-1">send</span>
          </button>
        </div>
        <div class="flex items-center gap-4 mt-3 px-2">
          <button
            class="flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-primary transition-colors"
          >
            <span class="material-symbols-outlined text-lg">card_giftcard</span>
            Support
          </button>
          <button
            class="flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-primary transition-colors"
          >
            <span class="material-symbols-outlined text-lg">attachment</span>
            Attach
          </button>
        </div>
      </div>
    </div>
  </body>
</html>
