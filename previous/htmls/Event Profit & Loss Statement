<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Event Profit &amp; Loss - Indian Cobbler Community</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#f2780d",
              "background-light": "#f8f7f5",
              "background-dark": "#221810",
            },
            fontFamily: {
              display: ["Public Sans"],
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              full: "9999px",
            },
          },
        },
      };
    </script>
    <style>
      body {
        min-height: max(884px, 100dvh);
      }
    </style>
  </head>
  <body
    class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100"
  >
    <div class="relative flex min-h-screen w-full flex-col overflow-x-hidden">
      <header
        class="flex items-center bg-background-light dark:bg-background-dark p-4 border-b border-primary/10 sticky top-0 z-10"
      >
        <div
          class="text-primary flex size-10 shrink-0 items-center justify-center rounded-full hover:bg-primary/10 cursor-pointer"
        >
          <span class="material-symbols-outlined">arrow_back</span>
        </div>
        <div class="flex-1 ml-2">
          <h1 class="text-lg font-bold leading-tight tracking-tight">
            Annual Artisans Meet 2024
          </h1>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Financial Summary • Jan 15-17
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button
            class="flex size-10 items-center justify-center rounded-full hover:bg-primary/10 text-slate-700 dark:text-slate-300"
          >
            <span class="material-symbols-outlined">share</span>
          </button>
          <button
            class="flex size-10 items-center justify-center rounded-full hover:bg-primary/10 text-slate-700 dark:text-slate-300"
          >
            <span class="material-symbols-outlined">download</span>
          </button>
        </div>
      </header>
      <main class="flex-1 pb-24">
        <div class="flex flex-wrap gap-4 p-4">
          <div
            class="flex min-w-[150px] flex-1 flex-col gap-1 rounded-xl p-5 bg-white dark:bg-slate-800 shadow-sm border border-slate-100 dark:border-slate-700"
          >
            <div
              class="flex items-center gap-2 text-slate-500 dark:text-slate-400 mb-1"
            >
              <span class="material-symbols-outlined text-sm"
                >account_balance_wallet</span
              >
              <p class="text-sm font-medium">Total Income</p>
            </div>
            <p class="tracking-tight text-2xl font-bold">₹8,45,000</p>
            <div class="flex items-center gap-1 mt-1">
              <span class="material-symbols-outlined text-green-600 text-xs"
                >trending_up</span
              >
              <p class="text-green-600 text-xs font-semibold">
                +12.5% vs target
              </p>
            </div>
          </div>
          <div
            class="flex min-w-[150px] flex-1 flex-col gap-1 rounded-xl p-5 bg-white dark:bg-slate-800 shadow-sm border border-slate-100 dark:border-slate-700"
          >
            <div
              class="flex items-center gap-2 text-slate-500 dark:text-slate-400 mb-1"
            >
              <span class="material-symbols-outlined text-sm">payments</span>
              <p class="text-sm font-medium">Total Expenses</p>
            </div>
            <p class="tracking-tight text-2xl font-bold">₹5,12,400</p>
            <div class="flex items-center gap-1 mt-1">
              <span class="material-symbols-outlined text-amber-600 text-xs"
                >warning</span
              >
              <p class="text-amber-600 text-xs font-semibold">8% over budget</p>
            </div>
          </div>
          <div
            class="flex min-w-[150px] flex-1 flex-col gap-1 rounded-xl p-5 bg-primary/10 dark:bg-primary/20 border border-primary/20"
          >
            <div class="flex items-center gap-2 text-primary mb-1">
              <span class="material-symbols-outlined text-sm">analytics</span>
              <p class="text-sm font-bold">Net Profit</p>
            </div>
            <p class="tracking-tight text-2xl font-bold text-primary">
              ₹3,32,600
            </p>
            <div class="flex items-center gap-1 mt-1">
              <span class="material-symbols-outlined text-green-600 text-xs"
                >verified</span
              >
              <p class="text-green-600 text-xs font-semibold">39.3% Margin</p>
            </div>
          </div>
        </div>
        <section class="px-4 mt-2">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-bold">Income Breakdown</h2>
            <span
              class="text-xs font-bold text-green-600 bg-green-50 dark:bg-green-900/20 px-2 py-1 rounded"
              >CREDIT</span
            >
          </div>
          <div class="space-y-3">
            <div
              class="flex items-center gap-4 bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-100 dark:border-slate-700"
            >
              <div
                class="text-primary flex items-center justify-center rounded-lg bg-primary/10 shrink-0 size-12"
              >
                <span class="material-symbols-outlined"
                  >confirmation_number</span
                >
              </div>
              <div class="flex flex-1 flex-col">
                <p class="text-sm font-bold">Ticket Sales</p>
                <p class="text-xs text-slate-500">450 General • 120 VIP</p>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold">₹5,80,000</p>
                <p class="text-[10px] text-green-600 font-medium">Completed</p>
              </div>
            </div>
            <div
              class="flex items-center gap-4 bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-100 dark:border-slate-700"
            >
              <div
                class="text-primary flex items-center justify-center rounded-lg bg-primary/10 shrink-0 size-12"
              >
                <span class="material-symbols-outlined">handshake</span>
              </div>
              <div class="flex flex-1 flex-col">
                <p class="text-sm font-bold">Sponsorships</p>
                <p class="text-xs text-slate-500">Bata India, Metro Shoes</p>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold">₹2,25,000</p>
                <p class="text-[10px] text-amber-600 font-medium">
                  ₹50k Pending
                </p>
              </div>
            </div>
            <div
              class="flex items-center gap-4 bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-100 dark:border-slate-700"
            >
              <div
                class="text-primary flex items-center justify-center rounded-lg bg-primary/10 shrink-0 size-12"
              >
                <span class="material-symbols-outlined">add_shopping_cart</span>
              </div>
              <div class="flex flex-1 flex-col">
                <p class="text-sm font-bold">Add-on Sales</p>
                <p class="text-xs text-slate-500">Workshop Kits &amp; Tools</p>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold">₹40,000</p>
                <p class="text-[10px] text-green-600 font-medium">Completed</p>
              </div>
            </div>
          </div>
        </section>
        <section class="px-4 mt-8">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-bold">Expense Breakdown</h2>
            <span
              class="text-xs font-bold text-red-600 bg-red-50 dark:bg-red-900/20 px-2 py-1 rounded"
              >DEBIT</span
            >
          </div>
          <div class="space-y-3">
            <div
              class="flex items-center gap-4 bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-100 dark:border-slate-700"
            >
              <div
                class="text-slate-400 flex items-center justify-center rounded-lg bg-slate-100 dark:bg-slate-700 shrink-0 size-12"
              >
                <span class="material-symbols-outlined">location_on</span>
              </div>
              <div class="flex flex-1 flex-col">
                <p class="text-sm font-bold">Venue &amp; Logistics</p>
                <p class="text-xs text-slate-500">Dharavi Community Center</p>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold text-red-500">-₹1,20,000</p>
                <p class="text-[10px] text-slate-400">Paid in full</p>
              </div>
            </div>
            <div
              class="flex items-center gap-4 bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-100 dark:border-slate-700"
            >
              <div
                class="text-slate-400 flex items-center justify-center rounded-lg bg-slate-100 dark:bg-slate-700 shrink-0 size-12"
              >
                <span class="material-symbols-outlined">restaurant</span>
              </div>
              <div class="flex flex-1 flex-col">
                <p class="text-sm font-bold">Catering</p>
                <p class="text-xs text-slate-500">Lunch &amp; Tea (3 Days)</p>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold text-red-500">-₹1,85,000</p>
                <p class="text-[10px] text-slate-400">Paid in full</p>
              </div>
            </div>
            <div
              class="flex items-center gap-4 bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-100 dark:border-slate-700"
            >
              <div
                class="text-slate-400 flex items-center justify-center rounded-lg bg-slate-100 dark:bg-slate-700 shrink-0 size-12"
              >
                <span class="material-symbols-outlined">construction</span>
              </div>
              <div class="flex flex-1 flex-col">
                <p class="text-sm font-bold">Materials &amp; Leather</p>
                <p class="text-xs text-slate-500">Live Demo Supplies</p>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold text-red-500">-₹95,000</p>
                <p class="text-[10px] text-slate-400">Paid in full</p>
              </div>
            </div>
            <div
              class="flex items-center gap-4 bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-100 dark:border-slate-700"
            >
              <div
                class="text-slate-400 flex items-center justify-center rounded-lg bg-slate-100 dark:bg-slate-700 shrink-0 size-12"
              >
                <span class="material-symbols-outlined">badge</span>
              </div>
              <div class="flex flex-1 flex-col">
                <p class="text-sm font-bold">Staffing &amp; Security</p>
                <p class="text-xs text-slate-500">12 Temporary Staff</p>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold text-red-500">-₹1,12,400</p>
                <p class="text-[10px] text-amber-600 font-medium">
                  Reconciling
                </p>
              </div>
            </div>
          </div>
        </section>
      </main>
      <nav
        class="fixed bottom-0 left-0 right-0 border-t border-primary/10 bg-background-light dark:bg-background-dark px-4 pb-6 pt-2 flex items-center justify-around z-20"
      >
        <a class="flex flex-col items-center gap-1 text-slate-400" href="#">
          <span class="material-symbols-outlined">dashboard</span>
          <p class="text-[10px] font-medium leading-normal">Dashboard</p>
        </a>
        <a class="flex flex-col items-center gap-1 text-slate-400" href="#">
          <span class="material-symbols-outlined">calendar_today</span>
          <p class="text-[10px] font-medium leading-normal">Events</p>
        </a>
        <a class="flex flex-col items-center gap-1 text-primary" href="#">
          <span
            class="material-symbols-outlined"
            style="font-variation-settings: &quot;FILL&quot; 1"
            >account_balance</span
          >
          <p class="text-[10px] font-bold leading-normal">Finances</p>
        </a>
        <a class="flex flex-col items-center gap-1 text-slate-400" href="#">
          <span class="material-symbols-outlined">person</span>
          <p class="text-[10px] font-medium leading-normal">Profile</p>
        </a>
      </nav>
    </div>
  </body>
</html>
