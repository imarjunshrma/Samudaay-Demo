          class="group relative aspect-square overflow-hidden rounded-xl bg-primary/5"
        >
          <div
            class="w-full h-full bg-center bg-no-repeat bg-cover transition-transform duration-500 group-hover:scale-110"
            data-alt="Detailed shot of a leather carving tool making an impression"
