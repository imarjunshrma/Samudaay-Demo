    <!-- Bottom Navigation Bar -->
    <nav
      class="sticky bottom-0 bg-background-light dark:bg-background-dark border-t border-primary/10 px-4 pb-6 pt-2"
    >
      <div class="flex max-w-2xl mx-auto w-full">
        <a
          class="flex flex-1 flex-col items-center justify-end gap-1 text-slate-400 dark:text-slate-500 hover:text-primary transition-colors"
          href="#"
        >
          <span class="material-symbols-outlined">calendar_today</span>
          <p class="text-xs font-medium">Events</p>
        </a>
        <a
          class="flex flex-1 flex-col items-center justify-end gap-1 text-primary"
          href="#"
        >
          <span
            class="material-symbols-outlined"
            style="font-variation-settings: &quot;FILL&quot; 1"
            >gallery_thumbnail</span
