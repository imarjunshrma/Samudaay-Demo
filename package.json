{
  "name": "MECTV",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client -c",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "preview-build": "eas build -p android --profile preview",
    "dev-build": "eas build -p android --profile development --clear-cache",
    "dev-build-ios": "eas build -p ios --profile development --clear-cache",
    "ota:test": "eas update --channel preview",
    "ota:prod": "eas update --channel production",
    "preview-build-new": "eas build -p android --profile preview --clear-cache",
    "production-build": "eas build --profile production --platform android  --clear-cache",
    "production-build-ios": "eas build -p ios --profile production",
    "build-submit-android": "eas submit -p android --profile production",
    "build-submit-ios": "eas submit -p ios --profile production",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
